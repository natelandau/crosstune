// Values a Release build needs that stay out of the repository. `just apple::setup` copies
// this file to Secrets.xcconfig, which git ignores. Only Release.xcconfig includes it, so no
// Debug build sends analytics or crash reports.

// The PostHog project token, from PostHog > Project settings > Project token. The release
// workflow writes it from the `app-store` environment's POSTHOG_PROJECT_TOKEN_PRODUCTION.
POSTHOG_PROJECT_TOKEN =

// The Sentry project's DSN, from Sentry > Project settings > Client Keys (DSN). An xcconfig
// reads `//` as a comment, so write the DSN's `://` as `:/$()/`.
SENTRY_DSN =
