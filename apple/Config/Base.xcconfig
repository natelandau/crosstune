// Settings shared by every configuration of the app target.
#include "Version.xcconfig"

// Registered in the developer portal with Sign in with Apple. Permanent after the first
// App Store upload.
PRODUCT_BUNDLE_IDENTIFIER = app.crosstune.Crosstune
DEVELOPMENT_TEAM = N76T49G924
PRODUCT_NAME = Crosstune

SUPPORTED_PLATFORMS = iphoneos iphonesimulator macosx
SDKROOT = auto
TARGETED_DEVICE_FAMILY = 1,2
IPHONEOS_DEPLOYMENT_TARGET = 26.1
MACOSX_DEPLOYMENT_TARGET = 26.0
SUPPORTS_MACCATALYST = NO

SWIFT_VERSION = 6.0
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Crosstune
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
// App Store Connect rejects an iPad app that supports multitasking without all four.
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.music
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
// Slate on the Mac reaches AppKit's own selection, focus rings, and default buttons, which
// SwiftUI's tint does not; iPhone and iPad keep the system blue.
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME[sdk=macosx*] = AccentColor
INFOPLIST_FILE = Config/Info.plist
CODE_SIGN_ENTITLEMENTS[sdk=iphone*] = Config/Crosstune-iOS.entitlements
CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = Config/Crosstune-macOS.entitlements
CODE_SIGN_STYLE = Automatic
ENABLE_PREVIEWS = YES
