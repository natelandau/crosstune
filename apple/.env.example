# Settings for the Apple recipes. `just apple::setup` copies this file to apple/.env,
# which git ignores. Only the release recipes (`just apple::testflight`, `archive`,
# `upload-symbols`, and `upload`) read them. The release workflow gets the same values from
# the `app-store` environment's secrets and variables instead.

# ==== App Store Connect API key ==============================================

# The .p8 file of a Team Key with the Admin role. Keep it outside the repository.
ASC_KEY_PATH=~/.appstoreconnect/AuthKey_KEY_ID.p8

# The 10 characters between `AuthKey_` and `.p8` in the file name.
ASC_KEY_ID=

# App Store Connect > Users and Access > Integrations > App Store Connect API, above
# the table of Team Keys.
ASC_ISSUER_ID=

# ==== Sentry =================================================================

# For `just apple::upload-symbols`, which uploads the archives' debug symbols with
# sentry-cli: an organization auth token, from Sentry > Settings > Auth Tokens, and the
# organization and Apple project slugs from the project's URL.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
