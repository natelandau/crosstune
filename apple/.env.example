# Settings for the Apple recipes. `just apple::setup` copies this file to apple/.env,
# which git ignores. Only `just apple::testflight` reads them. The release workflow
# gets the same key from the `app-store` environment's secrets instead.

# ==== App Store Connect API key ==============================================

# The .p8 file of a Team Key with the Admin role. Keep it outside the repository.
ASC_KEY_PATH=~/.appstoreconnect/AuthKey_KEY_ID.p8

# The 10 characters between `AuthKey_` and `.p8` in the file name.
ASC_KEY_ID=

# App Store Connect > Users and Access > Integrations > App Store Connect API, above
# the table of Team Keys.
ASC_ISSUER_ID=
