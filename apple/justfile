# Recipes for the Apple client. Loaded as the `apple` module by the root justfile and run
# from this directory: `just apple::test` from anywhere in the repository. Needs Xcode.

set shell := ["bash", "-euo", "pipefail", "-c"]
set dotenv-load

# Build products stay inside the module, so a clean checkout holds everything the build made.
derived_data := ".build/DerivedData"
# Builds run without credential-like environment variables, which Xcode and SwiftPM store in
# plain text under .build/.
xcodebuild := "scripts/scrub-env.sh xcodebuild"
swift := "scripts/scrub-env.sh swift"
# Runs a lint or test gate through gate-cache when it is installed
gate := "../scripts/gate-cache.sh"
# Marketing captures land here: each simulator pass's result bundle and exported attachments,
# and the Mac window still. `capture-test` clears it, so it only ever holds the latest run.
capture := ".build/capture"
# The release recipes read ASC_KEY_PATH, ASC_KEY_ID, and ASC_ISSUER_ID from the environment
# or apple/.env: an App Store Connect API key with the Admin role, which cloud signing needs.
asc_auth := '-allowProvisioningUpdates -authenticationKeyPath "$ASC_KEY_PATH" -authenticationKeyID "$ASC_KEY_ID" -authenticationKeyIssuerID "$ASC_ISSUER_ID"'
archives := ".build/archives"

[private]
default:
    @just --list apple

# Every hand-written Swift file; the generated client is left as the generator wrote it
[private]
sources:
    @find Crosstune CrosstuneKit CrosstuneMarketingUITests Tools -name '*.swift' -not -path '*/Generated/*' -not -path '*/.build/*'

# Check formatting and lint rules with swift format
[group('lint')]
format:
    {{ gate }} apple-swift-format --tool 'swift --version' bash -c 'just sources | xargs swift format lint --strict'

# Spell check the Apple client
[group('lint')]
typos:
    {{ gate }} apple-typos uv run --project ../api --only-group typos typos --config ../.typos.toml .

# Fail when the committed Swift client or vocabulary no longer match the OpenAPI schema
[group('lint')]
contract-check:
    {{ gate }} apple-contract-check --tool 'swift --version' just _contract-check

_contract-check:
    #!/usr/bin/env bash
    set -euo pipefail
    case "${CI:-}" in 1|true|yes) echo "skipping contract check: CI runs it as its own job"; exit 0 ;; esac
    out=.build/contract-check
    rm -rf "$out" && mkdir -p "$out"
    trap 'rm -rf "$out"' EXIT
    just _generate "$out"
    stale=0
    diff -ru CrosstuneKit/Sources/CrosstuneAPI/Generated "$out/Generated" || stale=1
    diff -u CrosstuneKit/Sources/CrosstuneVocabulary/Vocabulary.swift "$out/Vocabulary.swift" || stale=1
    [ "$stale" -eq 0 ] || { echo "the Swift client is stale; run just contract" >&2; exit 1; }

# Run all linters
[group('lint')]
lint: format typos contract-check

# of `lint` and CI. Settings are in CrosstuneKit/.periphery.yml.
# of `lint`; CI runs it after the build. Settings are in CrosstuneKit/.periphery.yml.
[group('lint')]
deadcode:
    {{ gate }} apple-deadcode --tool 'periphery version' --tool 'swift --version' just _deadcode

[private]
_deadcode: build
    {{ swift }} build --build-tests --quiet --package-path CrosstuneKit
    cd CrosstuneKit && periphery scan --quiet

# Fix formatting where swift format can
[group('lint')]
fix:
    just sources | xargs swift format --in-place

# Run the package tests on the Mac; extra args go to swift test
[group('test')]
[positional-arguments]
test *args:
    {{ gate }} apple-test --argc "$#" --tool 'swift --version' {{ swift }} test --package-path CrosstuneKit "$@"

# The compilation cache is keyed on content rather than file dates, so CI restores it into a
# fresh checkout and still hits.

# Build the app for the iOS Simulator and for macOS, unsigned
[group('build')]
build:
    for destination in 'generic/platform=iOS Simulator' 'generic/platform=macOS'; do \
        {{ xcodebuild }} build -quiet -project Crosstune.xcodeproj -scheme Crosstune \
            -destination "$destination" -derivedDataPath {{ derived_data }} CODE_SIGNING_ALLOWED=NO \
            COMPILATION_CACHE_ENABLE_CACHING=YES; \
    done

# Build the signed Debug Mac app and run it from ~/Applications; args go to the app
[group('run')]
[positional-arguments]
run *args:
    scripts/mac-app.sh run "$@"

# Quit the Mac app `just run` started and let the next worktree run it
[group('run')]
done:
    scripts/mac-app.sh done

# Show which worktree holds the Mac app and how many are waiting
[group('run')]
status:
    scripts/mac-app.sh status

# Record the marketing UI tests named (all when none) and export their attachments
[group('capture')]
[positional-arguments]
capture-test *names:
    CAPTURE='{{ capture }}' DERIVED_DATA='{{ derived_data }}' scripts/capture-test.sh "$@"

# Fail when the Mac's screen is locked, since a locked session draws no app windows
[private]
screen-unlocked:
    #!/usr/bin/env bash
    set -euo pipefail
    if ioreg -n Root -d1 -a | grep -A1 CGSSessionScreenIsLocked | grep -q '<true/>'; then
        echo "the screen is locked, so the Mac app draws no window; unlock it and run again" >&2
        exit 1
    fi

# Run the signed Mac app on the marketing catalog and capture its window to family-mac.png
[group('capture')]
capture-mac: screen-unlocked
    #!/usr/bin/env bash
    set -euo pipefail
    # The signed app is sandboxed, so it reads the fixture from a copy in its own container;
    # asset paths in the fixture are relative to it, so the assets come along.
    staged="$HOME/Library/Containers/app.crosstune.Crosstune/Data/Library/Caches/marketing-capture"
    rm -rf "$staged"
    mkdir -p "$staged"
    cp -R Marketing/catalog.json Marketing/assets "$staged/"
    fixture="$staged/catalog.json"
    mkdir -p {{ capture }}
    out="$PWD/{{ capture }}/family-mac.png"
    rm -f "$out"
    # Set before the launch, so a run that fails after claiming the app still releases it.
    trap 'scripts/mac-app.sh done > /dev/null' EXIT
    # Launch arguments set these for this run only, never the defaults every worktree shares.
    scripts/mac-app.sh run -MarketingShell "$fixture" -crosstune.appearance dark \
        -catalogSort.v1 title.asc
    # The install path mac-app.sh runs from; matching it never touches a Crosstune the user has open.
    app="$(cd "$HOME/Applications" && pwd -P)/Crosstune Dev.app"
    pid=""
    for _ in $(seq 1 30); do
        pid="$(pgrep -nf "^$app/Contents/MacOS/" || true)"
        [ -z "$pid" ] || break
        sleep 1
    done
    [ -n "$pid" ] || { echo "the Mac app did not start" >&2; exit 1; }
    # A fixture tune in the accessibility tree marks the catalog loaded.
    loaded=""
    for _ in $(seq 1 30); do
        if peekaboo see --pid "$pid" --no-screenshot --tree 2> /dev/null | grep -q 'Backstep Cindy'; then
            loaded=1
            break
        fi
        sleep 1
    done
    if [ -z "$loaded" ]; then
        peekaboo see --pid "$pid" --no-screenshot --tree > "{{ capture }}/family-mac-tree.txt" 2>&1 || true
        echo "the marketing catalog did not load in the Mac app; its window is in {{ capture }}/family-mac-tree.txt" >&2
        exit 1
    fi
    # Captured by window id: the app's window has no accessibility match that the
    # app-and-title selectors need.
    id="$(peekaboo window list --pid "$pid" --json | python3 -c '
    import json, sys
    windows = json.load(sys.stdin)["data"]["windows"]
    print(next(w["window_id"] for w in windows if w["window_title"] == "Catalog"))
    ')"
    peekaboo see --window-id "$id" --no-elements --retina --path "$out" > /dev/null
    echo "captured the Mac app to $out"

# Archive the signed Release build for iOS and macOS, ready for `just upload`
[group('release')]
archive build_number:
    #!/usr/bin/env bash
    set -euo pipefail
    : "${ASC_KEY_PATH:?the path of the .p8 key file}" "${ASC_KEY_ID:?the key ID}" "${ASC_ISSUER_ID:?the issuer ID}"
    # A .env file does not expand `~`.
    ASC_KEY_PATH="${ASC_KEY_PATH/#\~/$HOME}"
    # An empty token ships a release that silently sends no analytics. Reading the settings
    # whole lets a failed xcodebuild stop here instead of reading as an empty token.
    settings="$({{ xcodebuild }} -showBuildSettings -project Crosstune.xcodeproj -scheme Crosstune \
        -configuration Release)"
    if ! grep -qE '^ *POSTHOG_PROJECT_TOKEN = phc_' <<<"$settings"; then
        echo "POSTHOG_PROJECT_TOKEN is empty; set it in Config/Secrets.xcconfig" >&2
        exit 1
    fi
    rm -rf {{ archives }}
    for platform in iOS macOS; do
        {{ xcodebuild }} archive -quiet -project Crosstune.xcodeproj -scheme Crosstune \
            -configuration Release -destination "generic/platform=$platform" \
            -derivedDataPath {{ derived_data }} -archivePath "{{ archives }}/$platform.xcarchive" \
            CURRENT_PROJECT_VERSION='{{ build_number }}' {{ asc_auth }}
    done

# Upload the archives `just archive` made to App Store Connect
[group('release')]
upload:
    #!/usr/bin/env bash
    set -euo pipefail
    : "${ASC_KEY_PATH:?the path of the .p8 key file}" "${ASC_KEY_ID:?the key ID}" "${ASC_ISSUER_ID:?the issuer ID}"
    ASC_KEY_PATH="${ASC_KEY_PATH/#\~/$HOME}"
    for platform in iOS macOS; do
        rm -rf ".build/export/$platform"
        {{ xcodebuild }} -exportArchive -archivePath "{{ archives }}/$platform.xcarchive" \
            -exportOptionsPlist Config/ExportOptions.plist \
            -exportPath ".build/export/$platform" {{ asc_auth }}
    done

# Archive the Release build for iOS and macOS and upload both to App Store Connect
[group('release')]
testflight build_number: (archive build_number) upload

# Fail when Xcode made a development certificate, which a signing run must never leave behind
[group('release')]
check-certificates:
    #!/usr/bin/env bash
    set -euo pipefail
    if security find-identity -v -p codesigning | grep -q "Created via API"; then
        msg="Xcode created a development certificate; revoke it in the developer portal"
        if [ -n "${GITHUB_ACTIONS:-}" ]; then echo "::error::$msg"; else echo "$msg" >&2; fi
        exit 1
    fi

# Regenerate the Swift client and vocabulary from the committed OpenAPI contract
[group('contract')]
contract:
    #!/usr/bin/env bash
    set -euo pipefail
    out=.build/contract
    rm -rf "$out" && mkdir -p "$out"
    trap 'rm -rf "$out"' EXIT
    just _generate "$out"
    rm -rf CrosstuneKit/Sources/CrosstuneAPI/Generated
    mv "$out/Generated" CrosstuneKit/Sources/CrosstuneAPI/Generated
    mv "$out/Vocabulary.swift" CrosstuneKit/Sources/CrosstuneVocabulary/Vocabulary.swift

# Write the Swift client and the vocabulary into `out`; `contract` and `contract-check` share
# it, so the check compares exactly what `contract` would commit
_generate $out:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p "$out/Generated"
    {{ swift }} run -q --package-path Tools normalize-contract ../api/openapi.json "$out/openapi.json"
    {{ swift }} run -q --package-path Tools swift-openapi-generator generate \
        --config CrosstuneKit/Sources/CrosstuneAPI/openapi-generator-config.yaml \
        --output-directory "$out/Generated" \
        "$out/openapi.json" > /dev/null
    {{ swift }} run -q --package-path Tools generate-vocabulary ../api/openapi.json "$out/Vocabulary.swift"
    swift format --in-place --configuration .swift-format "$out/Vocabulary.swift"

# Upgrade the Swift package dependencies
[group('maintenance')]
update:
    {{ swift }} package update --package-path CrosstuneKit
    {{ swift }} package update --package-path Tools

# Create .env and Config/Secrets.xcconfig from their examples, and Config/Local.xcconfig for this Mac, if absent
[group('maintenance')]
setup:
    test -e .env || cp .env.example .env
    test -e Config/Secrets.xcconfig || cp Config/Secrets.xcconfig.example Config/Secrets.xcconfig
    test -e Config/Local.xcconfig || scripts/apple-local-xcconfig.sh > Config/Local.xcconfig

# Remove build artifacts and caches
[group('maintenance')]
clean:
    rm -rf .build CrosstuneKit/.build Tools/.build

# Delete Xcode's DerivedData for Crosstune checkouts that no longer exist
[group('maintenance')]
prune-derived-data:
    #!/usr/bin/env bash
    set -euo pipefail
    # Xcode never deletes the folder of a removed worktree. Only Crosstune-* folders are
    # candidates, so the caches every project shares stay.
    root="$HOME/Library/Developer/Xcode/DerivedData"
    [ -d "$root" ] || exit 0
    for dir in "$root"/Crosstune-*; do
        # A folder without a recorded project may still be in use, so only a missing project counts
        [ -f "$dir/info.plist" ] || continue
        project="$(/usr/libexec/PlistBuddy -c 'Print :WorkspacePath' "$dir/info.plist" 2>/dev/null || true)"
        if [ -n "$project" ] && [ ! -e "$project" ]; then
            rm -rf "$dir"
            echo "removed ${dir##*/} (${project})"
        fi
    done

# Delete simulators whose runtime is gone, and runtimes that are unusable or superseded
[group('maintenance')]
prune-sims:
    #!/usr/bin/env bash
    set -euo pipefail
    xcrun simctl delete unavailable
    for which in --unusable --outdated; do
        # Status 2 means no runtime matched
        xcrun simctl runtime delete "$which" || [ $? -eq 2 ]
    done
