# Recipes for the Apple client. Loaded as the `apple` module by the root justfile and run
# from this directory: `just apple::test` from anywhere in the repository. Needs Xcode.

set shell := ["bash", "-euo", "pipefail", "-c"]
set script-interpreter := ["bash", "-euo", "pipefail"]
set positional-arguments
set dotenv-load

# Build products stay inside the module, so a clean checkout holds everything the build made.
derived_data := ".build/DerivedData"
# Builds run without credential-like environment variables, which Xcode and SwiftPM store in
# plain text under .build/.
xcodebuild := "scripts/xcodebuild.sh"
swift := "scripts/scrub-env.sh swift"
# Runs a lint or test gate through gate-cache when it is installed
gate := "../scripts/gate-cache.sh"
# Marketing captures land here: each simulator pass's result bundle and exported attachments,
# and the Mac window still. `capture-test` clears it, so it only ever holds the latest run.
capture := ".build/capture"
# The release recipes read ASC_KEY_PATH, ASC_KEY_ID, and ASC_ISSUER_ID from the environment
# or apple/.env: an App Store Connect API key with the Admin role, which cloud signing needs.
asc_auth := '-allowProvisioningUpdates -authenticationKeyPath "$ASC_KEY_PATH" -authenticationKeyID "$ASC_KEY_ID" -authenticationKeyIssuerID "$ASC_ISSUER_ID"'
archives := ".build/archives"

[default]
_default:
    @just --list apple

# Every hand-written Swift file; the generated client is left as the generator wrote it
_sources:
    @find Crosstune CrosstuneKit CrosstuneMarketingUITests Tools -name '*.swift' -not -path '*/Generated/*' -not -path '*/.build/*'

# Check formatting and lint rules with swift format
[group('lint')]
format:
    {{ gate }} apple-swift-format --tool 'swift --version' bash -c 'just _sources | xargs swift format lint --strict'

# Spell check the Apple client
[group('lint')]
typos:
    {{ gate }} apple-typos uv run --project ../api --only-group typos typos --config ../.typos.toml .

# Fail when the Swift client is stale
[group('lint')]
contract-check:
    {{ gate }} apple-contract-check --tool 'swift --version' just _contract-check

[script]
_contract-check:
    case "${CI:-}" in 1|true|yes) echo "skipping contract check: CI runs it as its own job"; exit 0 ;; esac
    out=.build/contract-check
    rm -rf "$out" && mkdir -p "$out"
    trap 'rm -rf "$out"' EXIT
    just _generate "$out"
    stale=0
    diff -ru CrosstuneKit/Sources/CrosstuneAPI/Generated "$out/Generated" || stale=1
    diff -u CrosstuneKit/Sources/CrosstuneVocabulary/Vocabulary.swift "$out/Vocabulary.swift" || stale=1
    [ "$stale" -eq 0 ] || { echo "the Swift client is stale; run just contract" >&2; exit 1; }

# Run all linters
[group('lint')]
lint: format typos contract-check

# Fail on unused code in the package, its tests, and the app. Builds both first, so it stays out
# of `lint` and CI. Settings are in CrosstuneKit/.periphery.yml.
[doc("Find unused Swift code; builds the app first")]
[group('lint')]
deadcode:
    {{ gate }} apple-deadcode --tool 'periphery version' --tool 'swift --version' just _deadcode

_deadcode: build
    {{ swift }} build --build-tests --quiet --package-path CrosstuneKit
    cd CrosstuneKit && periphery scan --quiet

# Fix formatting where swift format can
[group('lint')]
fix:
    just _sources | xargs swift format --in-place

# Run the package tests on the Mac
[group('test')]
[arg("args", help="Arguments for swift test")]
test *args:
    {{ gate }} apple-test --argc "$#" --tool 'swift --version' {{ swift }} test --package-path CrosstuneKit "$@"

# The compilation cache is keyed on content rather than file dates, so CI restores it into a
# fresh checkout and still hits. Xcode's own limit is half the free disk, which a CI runner never
# reaches, so a cache restored and saved on every run would grow without end; this one prunes
# what recent builds have not used once it passes the limit.

# Build the app unsigned
[group('build')]
[arg("platform", pattern="all|ios|macos", help="all, ios, or macos")]
[script]
build platform='all':
    case "{{ platform }}" in
        all) destinations=('generic/platform=iOS Simulator' 'generic/platform=macOS') ;;
        ios) destinations=('generic/platform=iOS Simulator') ;;
        macos) destinations=('generic/platform=macOS') ;;
    esac
    for destination in "${destinations[@]}"; do
        {{ xcodebuild }} build -quiet -project Crosstune.xcodeproj -scheme Crosstune \
            -destination "$destination" -derivedDataPath {{ derived_data }} CODE_SIGNING_ALLOWED=NO \
            COMPILATION_CACHE_ENABLE_CACHING=YES COMPILATION_CACHE_LIMIT_SIZE=4G
    done

# Build and run the signed Debug Mac app
[group('run')]
[arg("args", help="Launch arguments for the app")]
run *args:
    uv run --project ../api python scripts/mac_app.py run "$@"

# Quit the Mac app and release it
[group('run')]
done:
    uv run --project ../api python scripts/mac_app.py done

# Capture Mac app surfaces over the sample catalog
[group('run')]
[arg("args", help="SampleScreen cases, such as tune, plan, or settings-account")]
shots *args:
    scripts/mac-shots.sh "$@"

# Show which worktree holds the Mac app
[group('run')]
status:
    uv run --project ../api python scripts/mac_app.py status

# Record the marketing UI tests
[group('capture')]
[arg("names", help="Marketing UI tests to record; none records all")]
capture-test *names:
    CAPTURE='{{ capture }}' DERIVED_DATA='{{ derived_data }}' scripts/capture-test.sh "$@"

# Capture the Mac marketing and store stills
[group('capture')]
capture-mac:
    scripts/capture-mac.sh

# Frame the store captures under headlines
[group('capture')]
store-frames:
    uv run --project ../api python scripts/store_frames.py {{ capture }} {{ capture }}/store

# Cut the capture into the iPhone App Preview
[group('capture')]
store-preview:
    uv run --project ../api python scripts/store_preview.py {{ capture }} {{ capture }}/store

# Archive the signed Release build for upload
[group('release')]
[arg("build_number", pattern="[0-9]+(\\.[0-9]+)*", help="The build number App Store Connect records")]
archive build_number:
    scripts/archive.sh '{{ build_number }}'

# Upload the archives to App Store Connect
[group('release')]
[script]
upload:
    : "${ASC_KEY_PATH:?the path of the .p8 key file}" "${ASC_KEY_ID:?the key ID}" "${ASC_ISSUER_ID:?the issuer ID}"
    ASC_KEY_PATH="${ASC_KEY_PATH/#\~/$HOME}"
    for platform in iOS macOS; do
        rm -rf ".build/export/$platform"
        scripts/scrub-env.sh xcodebuild -exportArchive -archivePath "{{ archives }}/$platform.xcarchive" \
            -exportOptionsPlist Config/ExportOptions.plist \
            -exportPath ".build/export/$platform" {{ asc_auth }}
    done

# Upload the archives' dSYMs to Sentry
[group('release')]
[script]
upload-symbols:
    : "${SENTRY_AUTH_TOKEN:?the Sentry auth token}" "${SENTRY_ORG:?the Sentry organization slug}" \
        "${SENTRY_PROJECT:?the Sentry project slug}"
    sentry-cli debug-files upload --wait {{ archives }}/iOS.xcarchive/dSYMs {{ archives }}/macOS.xcarchive/dSYMs

# Archive and upload a build to TestFlight
[group('release')]
[arg("build_number", pattern="[0-9]+(\\.[0-9]+)*", help="The build number App Store Connect records")]
testflight build_number: (archive build_number) upload-symbols upload

# Fail when Xcode left a development certificate
[group('release')]
[script]
check-certificates:
    if security find-identity -v -p codesigning | grep -q "Created via API"; then
        msg="Xcode created a development certificate; revoke it in the developer portal"
        if [ -n "${GITHUB_ACTIONS:-}" ]; then echo "::error::$msg"; else echo "$msg" >&2; fi
        exit 1
    fi

# Regenerate the Swift client from the contract
[group('contract')]
[script]
contract:
    out=.build/contract
    rm -rf "$out" && mkdir -p "$out"
    trap 'rm -rf "$out"' EXIT
    just _generate "$out"
    rm -rf CrosstuneKit/Sources/CrosstuneAPI/Generated
    mv "$out/Generated" CrosstuneKit/Sources/CrosstuneAPI/Generated
    mv "$out/Vocabulary.swift" CrosstuneKit/Sources/CrosstuneVocabulary/Vocabulary.swift

# Write the Swift client and the vocabulary into `out`; `contract` and `contract-check` share
# it, so the check compares exactly what `contract` would commit
[script]
_generate $out:
    mkdir -p "$out/Generated"
    {{ swift }} run -q --package-path Tools normalize-contract ../api/openapi.json "$out/openapi.json"
    {{ swift }} run -q --package-path Tools swift-openapi-generator generate \
        --config CrosstuneKit/Sources/CrosstuneAPI/openapi-generator-config.yaml \
        --output-directory "$out/Generated" \
        "$out/openapi.json" > /dev/null
    {{ swift }} run -q --package-path Tools generate-vocabulary ../api/openapi.json "$out/Vocabulary.swift"
    swift format --in-place --configuration .swift-format "$out/Vocabulary.swift"

# Upgrade the Swift package dependencies
[group('maintenance')]
update:
    {{ swift }} package update --package-path CrosstuneKit
    {{ swift }} package update --package-path Tools

# Create .env and Xcode config files if absent
[group('maintenance')]
setup:
    test -e .env || cp .env.example .env
    test -e Config/Secrets.xcconfig || cp Config/Secrets.xcconfig.example Config/Secrets.xcconfig
    test -e Config/Local.xcconfig || scripts/apple-local-xcconfig.sh > Config/Local.xcconfig

# Remove build artifacts and caches
[group('maintenance')]
clean:
    rm -rf .build CrosstuneKit/.build Tools/.build

# Delete DerivedData of removed checkouts
[group('maintenance')]
prune-derived-data:
    uv run --project ../api python scripts/derived_data.py prune

# Delete Swift package copies no checkout uses
[group('maintenance')]
prune-packages:
    python3 scripts/source_packages.py prune

# Delete builds of checkouts not building now
[group('maintenance')]
prune-builds:
    uv run --project ../api python scripts/builds.py prune
