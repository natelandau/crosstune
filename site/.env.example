# Settings for the site. Copy this file to site/.env for local work. Every name
# the site code or its build script reads is here, including the ones a host
# sets, which stay commented out.
#
# Astro puts only PUBLIC_ names in the page. Every other name here stays on the
# machine that runs the build.

# ==== Analytics (PostHog) ====================================================

# Leave unset locally. Without it the site loads no analytics.
# PUBLIC_POSTHOG_TOKEN=

# ==== Hosted builds only =====================================================

# Set by Workers Builds, never locally. The PostHog project token.
# hosted-build.sh exports it as PUBLIC_POSTHOG_TOKEN on the production branch
# only.
# POSTHOG_PROJECT_TOKEN_PRODUCTION=

# ==== Local development only =================================================

# Optional. Where the site's Sign in and Create account links go. Unset, they
# go to https://my.crosstune.app. `just dev` sets it to the local app.
# PUBLIC_APP_URL=http://localhost:5173
