# Recipes for the marketing site. Loaded as the `site` module by the root justfile and run
# from this directory: `just site::test` from anywhere in the repository.

import '../scripts/settings.just'

# Runs a lint or test gate through gate-cache when it is installed
gate := "../scripts/gate-cache.sh"

[default]
_default:
    @just --list site

# Lint with eslint
[group('lint')]
eslint:
    {{ gate }} site-eslint pnpm eslint --max-warnings 0 .

# Check formatting with prettier
[group('lint')]
format:
    {{ gate }} site-prettier pnpm prettier --check .

# Type check with astro check
[group('lint')]
tsc:
    {{ gate }} site-tsc pnpm astro check

# Spell check the site and the brand sources it is built from
[group('lint')]
typos:
    {{ gate }} site-typos uv run --project ../api --only-group typos typos --config ../.typos.toml . ../brand

# Find unused files, exports, and dependencies with knip
[group('lint')]
deadcode:
    {{ gate }} site-knip pnpm knip

# Run all linters
[group('lint')]
lint: eslint format tsc typos deadcode

# Fix lint and formatting where tools can
[group('lint')]
fix:
    pnpm eslint --fix .
    pnpm prettier --write .

# Build the site, then run the tests against the output
[group('test')]
[arg("args", help="Arguments for vitest")]
test *args:
    {{ gate }} site-test --argc "$#" --file .env --tool 'node --version' just _test "$@"

_test *args:
    pnpm astro build
    pnpm vitest run "$@"

# Run the dev server
[group('run')]
dev:
    pnpm astro dev

# Build for production and validate the Worker
[group('build')]
build:
    pnpm astro build
    pnpm wrangler deploy --dry-run

# Remove build artifacts and caches
[group('maintenance')]
clean:
    rm -rf dist .astro node_modules/.vite .vitest

# Upgrade dependencies within dependabot's ranges
[group('maintenance')]
update:
    pnpm update --latest '!typescript' '!@types/node'
    pnpm update typescript @types/node

# Install dependencies
[group('maintenance')]
setup:
    pnpm install --frozen-lockfile

# Rewrite the subset fonts from fontsource
[group('build')]
fonts:
    node scripts/fonts.ts

# Copy the web app's touch icon and favicon
[group('build')]
icons:
    cp ../web/public/apple-touch-icon-180x180.png ../web/public/favicon.ico public/

# Rebuild the link-preview image from the home page's hero
[group('build')]
og:
    scripts/og.sh
