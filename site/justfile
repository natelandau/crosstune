# Recipes for the marketing site. Loaded as the `site` module by the root justfile and run
# from this directory: `just site::test` from anywhere in the repository.

set shell := ["bash", "-euo", "pipefail", "-c"]

[private]
default:
    @just --list site

# Lint with eslint
[group('lint')]
eslint:
    pnpm eslint --max-warnings 0 .

# Check formatting with prettier
[group('lint')]
format:
    pnpm prettier --check .

# Type check with astro check
[group('lint')]
tsc:
    pnpm astro check

# Spell check the site and the brand sources it is built from
[group('lint')]
typos:
    uv run --project ../api --only-group typos typos --config ../.typos.toml . ../brand

# Run all linters
[group('lint')]
lint: eslint format tsc typos

# Fix lint and formatting where tools can
[group('lint')]
fix:
    pnpm eslint --fix .
    pnpm prettier --write .

# Build the site, then run the tests against the output; extra args go to vitest
[group('test')]
[positional-arguments]
test *args:
    pnpm astro build
    pnpm vitest run "$@"

# Run the dev server
[group('run')]
dev:
    pnpm astro dev

# Build for production and validate the Worker config without uploading
[group('build')]
build:
    pnpm astro build
    pnpm wrangler deploy --dry-run

# Remove build artifacts and caches
[group('maintenance')]
clean:
    rm -rf dist .astro node_modules/.vite .vitest

# Upgrade dependencies, holding the majors .github/dependabot.yml ignores to their range
[group('maintenance')]
update:
    pnpm update --latest '!typescript' '!@types/node'
    pnpm update typescript @types/node

# Install dependencies
[group('maintenance')]
setup:
    pnpm install --frozen-lockfile

# Rewrite the subset fonts in src/assets/fonts from the fontsource packages
[group('build')]
fonts:
    node scripts/fonts.ts

# Copy the touch icon and ICO favicon the web app generates from ../brand
[group('build')]
icons:
    cp ../web/public/apple-touch-icon-180x180.png ../web/public/favicon.ico public/

# Rebuild the link-preview image from the home page's hero
[group('build')]
og:
    #!/usr/bin/env bash
    set -euo pipefail
    pnpm astro build > /dev/null
    # astro preview moves to a free port when 4398 is taken, which would leave this recipe
    # screenshotting whatever already holds it.
    if curl -s -o /dev/null http://localhost:4398/; then
        echo "port 4398 is in use; stop the server holding it (lsof -iTCP:4398 -sTCP:LISTEN)" >&2
        exit 1
    fi
    # --ignore-lock lets this run beside a preview server someone already has open. Node runs
    # directly, not through the .bin shim, so the trap's kill reaches the server itself.
    node node_modules/astro/bin/astro.mjs preview --port 4398 --ignore-lock > /dev/null &
    preview=$!
    trap 'kill $preview 2> /dev/null' EXIT
    for _ in $(seq 150); do
        curl -sf http://localhost:4398/ > /dev/null 2>&1 && break
        kill -0 "$preview" 2> /dev/null || { echo "astro preview exited before serving" >&2; exit 1; }
        sleep 0.2
    done
    curl -sf http://localhost:4398/ > /dev/null 2>&1 || { echo "astro preview did not answer within 30s" >&2; exit 1; }
    node scripts/og.mjs 4398
