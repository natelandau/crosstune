# Recipes for the marketing site. Loaded as the `site` module by the root justfile and run
# from this directory: `just site::test` from anywhere in the repository.

set shell := ["bash", "-euo", "pipefail", "-c"]

[private]
default:
    @just --list site

# Lint with eslint
[group('lint')]
eslint:
    pnpm eslint --max-warnings 0 .

# Check formatting with prettier
[group('lint')]
format:
    pnpm prettier --check .

# Type check with astro check
[group('lint')]
tsc:
    pnpm astro check

# Spell check the site and the brand sources it is built from
[group('lint')]
typos:
    uv run --project ../api --only-group typos typos --config ../.typos.toml . ../brand

# Run all linters
[group('lint')]
lint: eslint format tsc typos

# Fix lint and formatting where tools can
[group('lint')]
fix:
    pnpm eslint --fix .
    pnpm prettier --write .

# Build the site, then run the tests against the output; extra args go to vitest
[group('test')]
[positional-arguments]
test *args:
    pnpm astro build
    pnpm vitest run "$@"

# Run the dev server
[group('run')]
dev:
    pnpm astro dev

# Build for production and validate the Worker config without uploading
[group('build')]
build:
    pnpm astro build
    pnpm wrangler deploy --dry-run

# Remove build artifacts and caches
[group('maintenance')]
clean:
    rm -rf dist .astro node_modules/.vite .vitest

# Upgrade dependencies, holding the majors .github/dependabot.yml ignores to their range
[group('maintenance')]
update:
    pnpm update --latest '!typescript' '!@types/node'
    pnpm update typescript @types/node

# Install dependencies
[group('maintenance')]
setup:
    pnpm install --frozen-lockfile

# Capture the app's scenes on the simulator and turn them into site assets; names pick captures
[group('capture')]
capture *names:
    #!/usr/bin/env bash
    set -euo pipefail
    host_stills=" $(node --input-type=module -e "import { HOST_STILLS } from './capture/hosts.ts'; console.log(HOST_STILLS.join(' '))") "
    # The other modules' recipes resolve only from the root justfile.
    cd ..
    simulator=() hosts=()
    for name in {{ names }}; do
        if [[ "$host_stills" == *" $name "* ]]; then hosts+=("$name"); else simulator+=("$name"); fi
    done
    wants() { [[ " ${hosts[*]-} " == *" $1 "* ]]; }
    # The host steps need an unlocked screen and `just dev`. Both are checked before the long
    # simulator pass: a host still named outright fails now, and a full run skips its step and
    # still publishes everything else.
    mac=false web=false
    skip=()
    if [ -z "{{ names }}" ]; then
        if just apple::screen-unlocked 2> /dev/null; then mac=true; else
            echo "skipping family-mac: the screen is locked" >&2
            skip+=(family-mac)
        fi
        if just site::dev-up 2> /dev/null; then web=true; else
            echo "skipping family-web and family-android: \`just dev\` is not running" >&2
            skip+=(family-web family-android)
        fi
    else
        if wants family-mac; then
            just apple::screen-unlocked || exit 1
            mac=true
        fi
        if wants family-web || wants family-android; then
            just site::dev-up || exit 1
            web=true
        fi
    fi
    # The simulator step clears apple/.build/capture, so it runs before the host steps.
    if [ -z "{{ names }}" ] || [ ${#simulator[@]} -gt 0 ]; then
        just apple::capture-test ${simulator[@]+"${simulator[@]}"}
    else
        mkdir -p apple/.build/capture
    fi
    if [ "$mac" = true ]; then just apple::capture-mac; fi
    if [ "$web" = true ]; then just site::capture-web; fi
    cd site
    # A skipped host still may have a PNG left from an earlier run; run.ts must not publish it.
    skipped="${skip[*]-}"
    node capture/run.ts --from ../apple/.build/capture/attachments ${skipped:+--skip "${skipped// /,}"} {{ names }}

# Fail unless `just dev` is serving the web app and the API
[private]
dev-up:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! curl -sf http://localhost:5173 > /dev/null || ! curl -sf http://localhost:8000/healthz > /dev/null; then
        echo "Start \`just dev\` first; the web captures sign in to the local app." >&2
        exit 1
    fi

# Capture the web app on desktop and Android signed in as the marketing account; needs `just dev` up
[group('capture')]
capture-web: dev-up
    node capture/web.ts

# Copy the touch icon and ICO favicon the web app generates from ../brand
[group('build')]
icons:
    cp ../web/public/apple-touch-icon-180x180.png ../web/public/favicon.ico public/

# Rebuild the link-preview image from the home page's hero
[group('build')]
og:
    #!/usr/bin/env bash
    set -euo pipefail
    pnpm astro build > /dev/null
    # astro preview moves to a free port when 4398 is taken, which would leave this recipe
    # screenshotting whatever already holds it.
    if curl -s -o /dev/null http://localhost:4398/; then
        echo "port 4398 is in use; stop the server holding it (lsof -iTCP:4398 -sTCP:LISTEN)" >&2
        exit 1
    fi
    # --ignore-lock lets this run beside a preview server someone already has open. Node runs
    # directly, not through the .bin shim, so the trap's kill reaches the server itself.
    node node_modules/astro/bin/astro.mjs preview --port 4398 --ignore-lock > /dev/null &
    preview=$!
    trap 'kill $preview 2> /dev/null' EXIT
    for _ in $(seq 150); do
        curl -sf http://localhost:4398/ > /dev/null 2>&1 && break
        kill -0 "$preview" 2> /dev/null || { echo "astro preview exited before serving" >&2; exit 1; }
        sleep 0.2
    done
    curl -sf http://localhost:4398/ > /dev/null 2>&1 || { echo "astro preview did not answer within 30s" >&2; exit 1; }
    node scripts/og.mjs 4398
