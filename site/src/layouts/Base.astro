---
import Footer from '../components/Footer.astro'
import Lockup from '../components/Lockup.astro'
import { OG_IMAGE_ALT } from '../components/seo'
import {
  APP_URL,
  JOIN_WAITLIST,
  JOIN_WAITLIST_SHORT,
  SECTIONS,
  SIGN_IN,
  WAITLIST_ID,
} from '../components/actions'
// The headline face, preloaded because the hero headline is the page's largest paint.
import headlineFont from '../assets/fonts/schibsted-grotesk.woff2?url'
import '../styles/tokens.css'
import '../styles/base.css'

interface Props {
  title: string
  description: string
  path: string
  /** Keep the page out of search results, as for the 404 page. */
  noindex?: boolean
}

const { title, description, path, noindex = false } = Astro.props
const canonical = `https://crosstune.app${path}`
// Off the home page the section links point back to it.
const home = path === '/' ? '' : '/'
const image = 'https://crosstune.app/og.png'
const imageAlt = OG_IMAGE_ALT
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preload" href={headlineFont} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-180x180.png" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Crosstune" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <slot name="head" />
  </head>
  <body>
    <header class="nav" data-nav>
      <div class="wrap">
        <Lockup />
        <nav aria-label="Main">
          <ul class="sections">
            {SECTIONS.map(([label, id]) => (
              <li>
                <a href={`${home}#${id}`}>{label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="nav-actions">
          <a class="sign-in" href={APP_URL}>
            {SIGN_IN}
          </a>
          <a class="button small" href={`${home}#${WAITLIST_ID}`}>
            <span class="long">{JOIN_WAITLIST}</span>
            <span class="short" aria-hidden="true">
              {JOIN_WAITLIST_SHORT}
            </span>
          </a>
        </div>
      </div>
    </header>
    <slot />
    <Footer />
    <script>
      import { startAnalytics } from '../scripts/analytics'

      startAnalytics(import.meta.env.PUBLIC_POSTHOG_TOKEN)

      const nav = document.querySelector<HTMLElement>('[data-nav]')
      if (nav) {
        const edge = () => nav.classList.toggle('scrolled', scrollY > 8)
        addEventListener('scroll', edge, { passive: true })
        edge()
      }
    </script>
  </body>
</html>
