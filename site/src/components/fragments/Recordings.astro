---
import KeyPill from './KeyPill.astro'
import Panel from './Panel.astro'
---

<Panel name="recordings">
  <div class="tune">
    <span class="name">Breaking Up Christmas</span>
    <KeyPill name="A" />
  </div>
  <ul>
    <li>
      <span class="glyph mine"></span>
      <span class="text">
        <span class="title">Porch, Sunday</span>
        <span class="source">Your recording, 1:42</span>
      </span>
      <span class="wave"></span>
    </li>
    <li>
      <span class="glyph youtube"></span>
      <span class="text">
        <span class="title">Tommy Jarrell, 1970s</span>
        <span class="source">YouTube</span>
      </span>
    </li>
    <li>
      <span class="glyph spotify"></span>
      <span class="text">
        <span class="title">Breaking Up Christmas</span>
        <span class="source">Spotify</span>
      </span>
    </li>
  </ul>
  <div class="controls">
    <span>Speed 0.75×</span>
    <span>Pitch −1</span>
  </div>
</Panel>

<style>
  .tune {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  .name {
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 0 0 1px var(--rule);
  }

  .text {
    display: grid;
    min-width: 0;
  }

  .title {
    font-size: 0.95rem;
    font-weight: 500;
  }

  .source {
    color: var(--slate-2);
    font-size: 0.8rem;
  }

  .glyph {
    position: relative;
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 9px;
  }

  .glyph::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
  }

  .mine {
    background: #fdeee7;
  }

  .mine::after {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--coral);
  }

  .youtube {
    background: #d9312b;
  }

  .youtube::after {
    margin-left: 1px;
    border-left: 10px solid #fff;
    border-block: 6px solid transparent;
  }

  .spotify {
    background: #1db954;
    border-radius: 50%;
  }

  .spotify::before,
  .spotify::after {
    content: '';
    position: absolute;
    left: 50%;
    translate: -50% 0;
    border-top: 2.5px solid var(--jet);
    border-radius: 50% 50% 0 0;
  }

  .spotify::before {
    top: 10px;
    width: 18px;
    height: 8px;
  }

  .spotify::after {
    top: 16px;
    width: 13px;
    height: 6px;
  }

  /* A waveform played through its first third, like the app's scrubber. */
  .wave {
    flex: 1;
    align-self: center;
    height: 26px;
    min-width: 40px;
    background: linear-gradient(90deg, var(--slate) 32%, var(--silver) 32%);
    mask: repeating-linear-gradient(90deg, #000 0 2px, transparent 2px 5px);
    clip-path: polygon(
      0 40%,
      6% 22%,
      12% 44%,
      18% 8%,
      24% 32%,
      30% 18%,
      36% 4%,
      42% 36%,
      48% 14%,
      54% 30%,
      60% 10%,
      66% 34%,
      72% 20%,
      78% 42%,
      84% 16%,
      90% 30%,
      96% 38%,
      100% 30%,
      100% 70%,
      96% 62%,
      90% 70%,
      84% 84%,
      78% 58%,
      72% 80%,
      66% 66%,
      60% 90%,
      54% 70%,
      48% 86%,
      42% 64%,
      36% 96%,
      30% 82%,
      24% 68%,
      18% 92%,
      12% 56%,
      6% 78%,
      0 60%
    );
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }

  .controls span {
    padding: 6px 12px;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 0 0 1px var(--rule);
    font-size: 0.8rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
</style>
