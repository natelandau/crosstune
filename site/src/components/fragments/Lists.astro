---
import Panel from './Panel.astro'

// Each list shows the keys of its first tunes as a strip of key-colored pips, by pitch class.
const lists = [
  { name: 'Saturday session', count: 14, keys: [9, 9, 2, 2, 7, 9] },
  { name: 'Band sets', count: 22, keys: [2, 2, 2, 9, 9, 7] },
  { name: 'Learn by spring', count: 9, keys: [9, 7, 2, 0, 9] },
  { name: 'Waltzes', count: 11, keys: [2, 7, 7, 0, 5] },
]
---

<Panel name="lists">
  <ul>
    {lists.map(({ name, count, keys }) => (
      <li>
        <span class="name">{name}</span>
        <span class="count">{count} tunes</span>
        <span class="pips">
          {keys.map((pc) => (
            <span style={`background: var(--key-${pc}-bg)`} />
          ))}
        </span>
      </li>
    ))}
  </ul>
</Panel>

<style>
  ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    gap: 2px;
    padding: 16px;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 0 0 1px var(--rule);
  }

  .name {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .count {
    color: var(--slate-2);
    font-size: 0.8rem;
  }

  .pips {
    display: flex;
    gap: 4px;
    margin-top: 10px;
  }

  .pips span {
    width: 14px;
    height: 6px;
    border-radius: 3px;
  }
</style>
