---
// The ground a section's app fragment sits on. Hidden from assistive tech: the section's
// words carry the meaning.
interface Props {
  name: string
}

const { name } = Astro.props
---

<div class="panel" data-fragment={name} aria-hidden="true">
  <slot />
</div>

<style>
  .panel {
    padding: 24px;
    border-radius: 20px;
    background: var(--mist);
    color: var(--jet);
    font-size: 1rem;
    line-height: 1.35;
  }

  @media (max-width: 420px) {
    .panel {
      padding: 16px;
    }
  }
</style>
