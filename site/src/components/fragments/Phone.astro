---
// A drawn phone. Sized in em, so the parent's font-size scales the whole device.
interface Props {
  signal?: string
  class?: string
}

const { signal, class: className } = Astro.props
---

<div class:list={['phone', className]}>
  <div class="screen">
    <div class="status-bar">
      <span>9:41</span>
      {signal && <span class="signal">{signal}</span>}
    </div>
    <slot />
  </div>
</div>

<style>
  .phone {
    width: 15em;
    padding: 0.5em;
    border-radius: 2.2em;
    background: var(--jet);
    box-shadow: 0 2em 3.5em -1.6em rgb(45 49 66 / 0.55);
  }

  .screen {
    height: var(--screen-height, 26em);
    padding: 0.75em 0.85em 0;
    overflow: hidden;
    border-radius: 1.75em;
    background: #fff;
    color: var(--jet);
    line-height: 1.3;
  }

  .status-bar {
    display: flex;
    justify-content: space-between;
    margin: 0 0.4em 1.1em;
    font-size: 0.7em;
    font-weight: 600;
  }

  .signal {
    color: var(--slate-2);
    font-weight: 500;
  }
</style>
