---
// The app's status dots: known filled slate, learning filled clay, want to learn a hollow ring.
interface Props {
  status: 'known' | 'learning' | 'unknown'
}

const { status } = Astro.props
---

<span class:list={['dot', status]}></span>

<style>
  .dot {
    flex: none;
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
  }

  .known {
    background: var(--slate);
  }

  .learning {
    background: var(--clay);
  }

  .unknown {
    box-shadow: inset 0 0 0 1.5px var(--silver);
  }
</style>
