---
import DemoPanel from './DemoPanel.astro'
import JoinForm from './JoinForm.astro'
import { HERO_LEDE, HERO_LEDE_LEAD, HERO_TITLE } from './hero'
---

<section class="hero wrap" aria-labelledby="hero-title">
  <div class="top">
    <h1 id="hero-title">{HERO_TITLE}</h1>
    <div class="side">
      <p class="lede">
        <strong>{HERO_LEDE_LEAD}</strong> {HERO_LEDE}
      </p>
      <JoinForm id="hero" />
    </div>
  </div>
  <DemoPanel name="hero" />
</section>

<style>
  .hero {
    padding-top: clamp(48px, 8vw, 104px);
  }

  .top {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 48px;
    align-items: end;
  }

  h1 {
    max-width: 11ch;
    font-size: var(--h1);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .side {
    display: grid;
    gap: 28px;
    padding-bottom: 6px;
  }

  .lede {
    max-width: 36ch;
    color: var(--ink-2);
    font-size: clamp(19px, 1.7vw, 22px);
    line-height: 1.45;
  }

  .lede strong {
    color: var(--ink);
    font-weight: 600;
  }

  @media (max-width: 860px) {
    .top {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
