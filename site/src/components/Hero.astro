---
import { APP_URL, JOIN_WAITLIST, SIGN_IN, WAITLIST_ID } from './actions'
import PaperList from './PaperList.astro'
import PhoneCatalog from './PhoneCatalog.astro'
---

<section class="hero column" aria-labelledby="hero-title">
  <div class="words">
    <h1 id="hero-title">The tune list in your case, rebuilt for your phone.</h1>
    <p class="lede">
      Crosstune is a tune list and practice app for musicians who learn by ear. Keep every tune you
      know or want to learn next to the recordings you learn from, then slow them down, shift the
      pitch, and loop the hard parts. Made for old-time, bluegrass, Irish, and folk players.
    </p>
    <div class="actions">
      <a class="button" href={`#${WAITLIST_ID}`}>
        {JOIN_WAITLIST}
      </a>
      <a class="text-link" href={APP_URL}>
        {SIGN_IN}
      </a>
    </div>
  </div>
  <div class="stage">
    <div class="paper-slot">
      <PaperList />
    </div>
    <div class="phone-slot">
      <PhoneCatalog />
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 32px;
    align-items: center;
    padding-block: 32px 72px;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 1.4rem + 3vw, 3.4rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .lede {
    max-width: 36ch;
    margin: 20px 0 0;
    color: var(--slate);
    font-size: 1.125rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: 32px;
  }

  .text-link {
    font-weight: 500;
  }

  /*
   * The stage is drawn in em so one font-size scales paper and phone together. At narrow
   * widths it shrinks with the viewport: 29em fills the column inside 16px gutters.
   */
  .stage {
    position: relative;
    width: 29em;
    height: 30em;
    font-size: min(16px, calc((100vw - 32px) / 29));
  }

  .paper-slot {
    position: absolute;
    top: 3em;
    left: 0.6em;
  }

  .phone-slot {
    position: absolute;
    top: 0;
    right: 0;
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      padding-block: 16px 56px;
    }

    .stage {
      margin-top: 8px;
    }
  }
</style>
