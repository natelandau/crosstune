---
// The icon sprite, plus the pointer, signal, and battery, which are drawn device chrome for the
// demos rather than icons.
import { SPRITE } from '../demos/sprite'
---

<svg class="icon-sprite" width="0" height="0" aria-hidden="true">
  <defs>
    <Fragment set:html={SPRITE} />
    <symbol id="i-cursor" viewBox="0 0 24 24">
      <path
        d="M4 2.5v17.2l4.6-4.3 3 6.6 3-1.4-3-6.5 6.4-.3z"
        fill="#1d2230"
        stroke="#fff"
        stroke-width="1.6"
        stroke-linejoin="round"
      ></path>
    </symbol>
    <symbol id="i-signal" viewBox="0 0 18 11" fill="currentColor">
      <rect x="0" y="7" width="3" height="4" rx="1"></rect>
      <rect x="5" y="5" width="3" height="6" rx="1"></rect>
      <rect x="10" y="2.5" width="3" height="8.5" rx="1"></rect>
      <rect x="15" y="0" width="3" height="11" rx="1"></rect>
    </symbol>
    <symbol id="i-battery" viewBox="0 0 26 12">
      <rect
        x=".5"
        y=".5"
        width="22"
        height="11"
        rx="3.2"
        fill="none"
        stroke="currentColor"
        opacity=".4"
      ></rect>
      <rect x="2" y="2" width="17" height="8" rx="2" fill="currentColor"></rect>
      <path d="M24 4v4c.8-.3 1.3-1 1.3-2s-.5-1.7-1.3-2Z" fill="currentColor" opacity=".45"></path>
    </symbol>
  </defs>
</svg>

<style>
  .icon-sprite {
    position: absolute;
    overflow: hidden;
  }
</style>
