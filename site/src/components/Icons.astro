---
// The icon sprite, plus the pointer, signal, and battery, which are drawn device chrome for the
// demos rather than icons, and the Apple logo from Apple's App Store badge artwork.
import { SPRITE } from '../demos/sprite'
---

<svg class="icon-sprite" width="0" height="0" aria-hidden="true">
  <defs>
    <Fragment set:html={SPRITE} />
    <symbol id="i-cursor" viewBox="0 0 24 24">
      <path
        d="M4 2.5v17.2l4.6-4.3 3 6.6 3-1.4-3-6.5 6.4-.3z"
        fill="#1d2230"
        stroke="#fff"
        stroke-width="1.6"
        stroke-linejoin="round"
      ></path>
    </symbol>
    <symbol id="i-apple" viewBox="7.5 8.5 18 23" fill="currentColor">
      <path d="M24.76888,20.30068a4.94881,4.94881,0,0,1,2.35656-4.15206,5.06566,5.06566,0,0,0-3.99116-2.15768c-1.67924-.17626-3.30719,1.00483-4.1629,1.00483-.87227,0-2.18977-.98733-3.6085-.95814a5.31529,5.31529,0,0,0-4.47292,2.72787c-1.934,3.34842-.49141,8.26947,1.3612,10.97608.9269,1.32535,2.01018,2.8058,3.42763,2.7533,1.38706-.05753,1.9051-.88448,3.5794-.88448,1.65876,0,2.14479.88448,3.591.8511,1.48838-.02416,2.42613-1.33124,3.32051-2.66914a10.962,10.962,0,0,0,1.51842-3.09251A4.78205,4.78205,0,0,1,24.76888,20.30068Z"></path>
      <path d="M22.03725,12.21089a4.87248,4.87248,0,0,0,1.11452-3.49062,4.95746,4.95746,0,0,0-3.20758,1.65961,4.63634,4.63634,0,0,0-1.14371,3.36139A4.09905,4.09905,0,0,0,22.03725,12.21089Z"></path>
    </symbol>
    <symbol id="i-signal" viewBox="0 0 18 11" fill="currentColor">
      <rect x="0" y="7" width="3" height="4" rx="1"></rect>
      <rect x="5" y="5" width="3" height="6" rx="1"></rect>
      <rect x="10" y="2.5" width="3" height="8.5" rx="1"></rect>
      <rect x="15" y="0" width="3" height="11" rx="1"></rect>
    </symbol>
    <symbol id="i-battery" viewBox="0 0 26 12">
      <rect
        x=".5"
        y=".5"
        width="22"
        height="11"
        rx="3.2"
        fill="none"
        stroke="currentColor"
        opacity=".4"
      ></rect>
      <rect x="2" y="2" width="17" height="8" rx="2" fill="currentColor"></rect>
      <path d="M24 4v4c.8-.3 1.3-1 1.3-2s-.5-1.7-1.3-2Z" fill="currentColor" opacity=".45"></path>
    </symbol>
  </defs>
</svg>

<style>
  .icon-sprite {
    position: absolute;
    overflow: hidden;
  }
</style>
