---
import { FAQ, FAQ_TITLE } from './faq'
---

<section id="questions" class="faq wrap" aria-labelledby="questions-title">
  <h2 id="questions-title">{FAQ_TITLE}</h2>
  <div class="list">
    {FAQ.map((item) => (
      <details>
        <summary>
          <h3>{item.question}</h3>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <use href="#i-plus" />
          </svg>
        </summary>
        <p class="answer">{item.answer}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
    gap: 56px;
    padding-block: clamp(48px, 6vw, 96px) var(--section-pad);
  }

  h2 {
    font-size: var(--h2);
    font-weight: 750;
    line-height: 1.04;
    letter-spacing: -0.03em;
  }

  details {
    border-bottom: 1px solid var(--line);
  }

  details:first-child {
    border-top: 1px solid var(--line);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 0;
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  h3 {
    font-size: 19px;
    font-weight: 600;
  }

  svg {
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--ink-2);
    transition: transform 0.25s;
  }

  details[open] svg {
    transform: rotate(45deg);
  }

  details p {
    max-width: 62ch;
    padding: 0 40px 22px 0;
    color: var(--ink-2);
  }

  @media (max-width: 860px) {
    .faq {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
