---
import { FAQ, FAQ_TITLE } from './faq'
---

<section id="questions" class="faq column" aria-labelledby="questions-title">
  <h2 id="questions-title">{FAQ_TITLE}</h2>
  <div class="list">
    {FAQ.map((item) => (
      <details class="item">
        <summary>
          <h3>{item.question}</h3>
        </summary>
        <p class="answer">{item.answer}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .faq {
    padding-block: var(--section-pad);
    border-top: 1px solid var(--rule);
  }

  h2 {
    margin: 0 0 32px;
    font-size: var(--section-size);
    font-weight: var(--section-weight);
    line-height: 1.02;
    letter-spacing: var(--tracking);
  }

  .list {
    max-width: 720px;
  }

  .item {
    border-bottom: 1px solid var(--rule);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 48px;
    padding-block: 18px;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* The marker carries empty alt text so it is not read out; the first value is for browsers
     without alt text in content. */
  summary::after {
    content: '+';
    content: '+' / '';
    flex: none;
    color: var(--slate);
    font-size: 1.5rem;
    line-height: 1;
  }

  .item[open] summary::after {
    content: '\2212';
    content: '\2212' / '';
  }

  summary:focus-visible {
    outline: 2px solid var(--jet);
    outline-offset: 2px;
  }

  h3 {
    margin: 0;
    font-size: var(--plan-size);
    font-weight: var(--plan-weight);
    line-height: 1.15;
    letter-spacing: var(--tracking);
    text-wrap: balance;
  }

  .answer {
    max-width: 60ch;
    margin: 0 0 22px;
    color: var(--slate);
    text-wrap: pretty;
  }
</style>
