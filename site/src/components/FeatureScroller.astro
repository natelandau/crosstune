---
// Desktop: each bulleted section pins in its own runway while scroll steps through its bullets,
// one whole phone per bullet beside a compact list with a rail, and a hand-drawn connector from
// the active bullet to its phone. Each run of sections without bullets scrolls past one pinned
// phone that crossfades to the section at the viewport middle. Section 8's full-width family
// shot follows. Below 900px nothing pins: each section without bullets shows its own whole phone
// under its text, and each bulleted section's list becomes a sideways carousel of cards, each a
// bullet above a whole phone.
import Capture from './capture/Capture.astro'
import Phone from './capture/Phone.astro'
import PhoneStack from './capture/PhoneStack.astro'
import FamilyShot from './FamilyShot.astro'
import { FEATURES, FEATURES_LINE, FEATURES_TITLE, type Bullet, type Feature } from './features'
import { PAUSE } from '../scripts/playback'
import { PHONE_SCREEN } from './capture/captures'

// The stage and pinned-phone CSS cap the phone at the same 300px.
const STAGE_WIDTH = 300
const PANEL_WIDTH = 260

type Own = { feature: Feature; capture: string; alt: string }
type Group =
  { kind: 'bulleted'; feature: Feature; bullets: Bullet[] } | { kind: 'stage'; steps: Own[] }

/** Each section before the family shot: a bulleted one alone, or a run of unbulleted ones. */
const groups: Group[] = []
for (const feature of FEATURES.filter((f) => f.capture !== 'family')) {
  if (feature.bullets) {
    groups.push({ kind: 'bulleted', feature, bullets: feature.bullets })
    continue
  }
  if (!feature.alt) throw new Error(`Feature ${feature.id} has no capture description`)
  const own = { feature, capture: feature.capture, alt: feature.alt }
  const last = groups.at(-1)
  if (last?.kind === 'stage') last.steps.push(own)
  else groups.push({ kind: 'stage', steps: [own] })
}
const family = FEATURES.find((feature) => feature.capture === 'family') as Feature
const headingId = (feature: Feature) => `feature-${feature.id}`
// The stage's height follows from its phone's, so the CSS needs the phone's shape.
const phoneRatio = PHONE_SCREEN.width / PHONE_SCREEN.height
---

<section
  id="features"
  class="features column"
  style={`--phone-ratio: ${phoneRatio}`}
  aria-labelledby="features-title"
  data-features
>
  <header class="intro">
    <h2 id="features-title">{FEATURES_TITLE}</h2>
    <p>{FEATURES_LINE}</p>
  </header>

  {groups.map((group) =>
    group.kind === 'bulleted' ? (
      <article
        class="feature bulleted"
        aria-labelledby={headingId(group.feature)}
        data-bulleted
        data-feature={group.feature.id}
      >
        <div class="runway" style={`--n: ${group.bullets.length}`} data-runway>
          <div class="pinned">
            <svg class="connector" aria-hidden="true" data-connector />
            <div class="copy">
              <h3 id={headingId(group.feature)}>{group.feature.heading}</h3>
              {group.feature.body.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
              <ul class="points" data-track>
                {group.bullets.map((bullet, i) => (
                  <li class="card" data-card>
                    <span class="point" data-bullet={i}>
                      {bullet.text}
                    </span>
                    <div class="panel" data-panel>
                      <Phone
                        name={bullet.capture}
                        alt={bullet.alt}
                        width={PANEL_WIDTH}
                        poster="lazy"
                      />
                    </div>
                  </li>
                ))}
              </ul>
              <div class="carousel-controls" data-carousel-controls hidden>
                <div class="marks">
                  {group.bullets.map((bullet, i) => (
                    <button
                      type="button"
                      class="mark"
                      aria-label={bullet.text}
                      aria-current={i === 0 ? 'true' : undefined}
                      data-card-mark
                    />
                  ))}
                </div>
                <button type="button" class="clip-toggle" data-clip-toggle hidden>
                  {PAUSE}
                </button>
              </div>
              {group.feature.plan && <p class="plan">{group.feature.plan}</p>}
            </div>
            <div class="side" data-side>
              <PhoneStack
                names={group.bullets.map((bullet) => bullet.capture)}
                alts={group.bullets.map((bullet) => bullet.alt)}
                width={STAGE_WIDTH}
                posters={group.bullets.map(() => 'lazy')}
              />
              <div class="side-controls">
                <div class="marks" data-marks hidden>
                  {group.bullets.map((bullet, i) => (
                    <button
                      type="button"
                      class="mark"
                      aria-label={bullet.text}
                      aria-current={i === 0 ? 'true' : undefined}
                      data-mark
                    />
                  ))}
                </div>
                <button type="button" class="clip-toggle" data-clip-toggle hidden>
                  {PAUSE}
                </button>
              </div>
            </div>
          </div>
          {group.bullets.map((_, i) => (
            <div class="snap" style={`--i: ${i}`} />
          ))}
        </div>
      </article>
    ) : (
      <div class="scroller" data-stage-group>
        <div class="steps">
          {group.steps.map(({ feature, capture, alt }) => (
            <article
              class="feature step"
              aria-labelledby={headingId(feature)}
              data-feature-step
              data-feature={feature.id}
            >
              <div class="copy">
                <h3 id={headingId(feature)}>{feature.heading}</h3>
                {feature.body.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
                {feature.plan && <p class="plan">{feature.plan}</p>}
              </div>
              <div class="media">
                <div class="panel" data-panel>
                  <Phone name={capture} alt={alt} width={PANEL_WIDTH} poster="lazy" />
                </div>
                <button type="button" class="clip-toggle" data-clip-toggle hidden>
                  {PAUSE}
                </button>
              </div>
            </article>
          ))}
        </div>

        <div class="stage" data-stage>
          <Phone width={STAGE_WIDTH}>
            <div class="items">
              {group.steps.map(({ feature, capture, alt }, i) => (
                <div
                  class="item"
                  data-stage-item={feature.id}
                  data-active={i === 0 ? '' : undefined}
                  aria-hidden={i === 0 ? undefined : 'true'}
                >
                  <Capture
                    name={capture}
                    alt={alt}
                    width={STAGE_WIDTH}
                    poster={i === 0 ? 'lazy' : undefined}
                    defer={i > 0}
                  />
                </div>
              ))}
            </div>
          </Phone>
          <button type="button" class="clip-toggle" data-clip-toggle hidden>
            {PAUSE}
          </button>
        </div>
      </div>
    ),
  )}

  <p class="visually-hidden" aria-live="polite" data-features-live></p>

  <article class="feature anywhere" aria-labelledby={headingId(family)}>
    <div class="copy">
      <h3 id={headingId(family)}>{family.heading}</h3>
      {family.body.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
    <FamilyShot />
  </article>
</section>

<style>
  .features {
    --step-height: 88svh;
    /* The stage: its phone, capped at 300px wide and by the step height, then the toggle under
       it. */
    --stage-h: calc(min(300px / var(--phone-ratio), var(--step-height) - 108px) + 60px);
    padding-block: var(--section-pad);
  }

  .intro h2,
  h3 {
    margin: 0;
    font-size: var(--section-size);
    font-weight: var(--section-weight);
    line-height: 1.02;
    letter-spacing: var(--tracking);
    text-wrap: balance;
  }

  .intro p {
    margin: 16px 0 0;
    color: var(--slate);
    font-size: 1.1875rem;
  }

  .copy {
    display: grid;
    gap: 18px;
    max-width: 52ch;
  }

  .copy p {
    margin: 0;
    text-wrap: pretty;
  }

  .points {
    display: grid;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }

  /* A plain-text row without JavaScript; a pinned section makes it a button. */
  .point {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: var(--jet);
    font: inherit;
    font-weight: 600;
    text-align: left;
  }

  button.point {
    cursor: pointer;
  }

  .point:focus-visible,
  .mark:focus-visible {
    outline: 3px solid var(--jet);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .carousel-controls[hidden] {
    display: none;
  }

  .plan {
    padding-top: 14px;
    border-top: 1px solid var(--rule);
    color: var(--slate);
    font-size: 0.9375rem;
  }

  .anywhere {
    padding-top: 120px;
  }

  .items {
    position: relative;
    height: 100%;
  }

  .item {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  /* Set by the script only when the visitor allows motion. */
  .stage[data-crossfade] .item {
    transition: opacity 200ms ease;
  }

  .item[data-active] {
    opacity: 1;
  }

  .item :global(.capture) {
    position: absolute;
    inset: 0;
  }

  .marks {
    display: flex;
    gap: 6px;
  }

  .marks[hidden] {
    display: none;
  }

  /* A short bar, in a hit area as tall as any other control. */
  .mark {
    display: grid;
    align-items: center;
    width: 28px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .mark::before {
    content: '';
    height: 4px;
    border-radius: 4px;
    background: var(--rule);
    transition: background 200ms ease;
  }

  .mark[aria-current='true']::before {
    background: var(--jet);
  }

  /* Drawn by the script between the active bullet and its phone; decoration only. */
  .connector {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .connector :global(path) {
    fill: none;
    stroke: var(--sketch);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The path's length is 1, so a dash of 1 offset by 1 draws it from nothing to whole. */
  .connector :global(.draw) {
    stroke-dasharray: 1;
    animation: connector-draw 650ms cubic-bezier(0.3, 0.6, 0.2, 1) both;
  }

  .connector :global(.head) {
    animation: connector-head 160ms 560ms ease both;
  }

  @keyframes connector-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes connector-head {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (min-width: 900px) {
    /* With a pinned section's 40px bottom padding, the same 120px as between the run's sections. */
    .scroller {
      padding-top: 80px;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: clamp(48px, 6vw, 96px);
    }

    /* Each section starts at the usual spacing after the one before; the stage phone stays
       pinned beside the run and shows the section that crosses the viewport middle. */
    .steps {
      display: grid;
      align-content: start;
      gap: 120px;
    }

    .step {
      display: grid;
      align-content: start;
    }

    /* As tall as the stage, so the stage stays pinned and whole until this section's top passes
       it. */
    .step:last-child {
      min-height: var(--stage-h);
    }

    .media,
    .points .panel,
    .carousel-controls {
      display: none;
    }

    /* As tall as its phone and toggle, and centered in the viewport. */
    .stage {
      position: sticky;
      top: max(0px, (100svh - var(--stage-h)) / 2);
      align-self: start;
      display: grid;
      justify-items: center;
      gap: 16px;
    }

    /* The height left after the margin and the pause toggle under the phone. */
    .stage :global(.phone) {
      width: min(300px, calc((var(--step-height) - 108px) * var(--ratio)));
    }

    /* Centered in the small viewport while it fits, so a mobile toolbar never covers its edge. */
    .bulleted .pinned {
      top: max(0px, (100svh - var(--pinned-h, 100svh)) / 2);
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: clamp(48px, 6vw, 96px);
      padding-block: 40px;
    }

    /* Short lines leave the connector room to run between the list and the phone. */
    .points {
      position: relative;
      gap: 2px;
      max-width: 32ch;
    }

    /* The rail: a hairline beside the list, with a jet segment beside the active bullet. */
    .points::before {
      content: '';
      position: absolute;
      top: 4px;
      bottom: 4px;
      left: 0;
      width: 2px;
      border-radius: 2px;
      background: var(--rule);
    }

    .points li {
      position: relative;
      padding-left: 20px;
    }

    .points li::before {
      content: '';
      position: absolute;
      top: 8px;
      bottom: 8px;
      left: 0;
      width: 2px;
      border-radius: 2px;
      background: var(--jet);
      transform: scaleY(0);
      transition: transform 250ms ease;
    }

    .points li:has(> .point[aria-current='true'])::before {
      transform: scaleY(1);
    }

    /* Dimmed by color rather than opacity, so inactive bullets keep 4.5:1 contrast. */
    .point {
      padding: 8px 0;
      color: var(--slate-2);
      transition: color 200ms ease;
    }

    button.point:hover,
    .point[aria-current='true'] {
      color: var(--jet);
    }

    .side {
      display: grid;
      justify-items: center;
      gap: 12px;
    }

    /* The marks and the pause toggle share one row under the phone, keeping the pinned block, and
       so the space it leaves before the next section, short. */
    .side-controls {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    /* Capped by the screen's height so the phone, its marks, and the pause toggle fit pinned. */
    .side :global(.stack) {
      width: min(300px, (100svh - 220px) * 0.46);
    }
  }

  /* The phone already shrinks with the screen's height, but the copy does not, so on a short
     screen (a laptop zoomed in) the copy tightens to keep the pinned block in view. */
  @media (min-width: 900px) and (max-height: 680px) {
    .bulleted h3 {
      font-size: 40px;
    }

    .bulleted .copy {
      gap: 12px;
    }

    .points {
      max-width: 46ch;
    }

    .point {
      padding-block: 4px;
    }
  }

  @media (max-width: 899.98px) {
    .features {
      /* The column's side padding, which a carousel bleeds into so cards slide to the screen
         edge. */
      --gutter: 40px;
    }

    .stage,
    .side,
    .connector {
      display: none;
    }

    /* Nothing pins on a narrow screen: the section sits in the flow. */
    .runway {
      height: auto;
    }

    .pinned {
      position: static;
      height: auto;
    }

    .snap {
      display: none;
    }

    .step,
    .bulleted {
      display: grid;
      gap: 32px;
      padding-top: 88px;
    }

    .media {
      display: grid;
      justify-items: center;
      gap: 12px;
    }

    .media .panel {
      justify-self: stretch;
    }

    .panel :global(.phone) {
      margin-inline: auto;
    }

    /* The carousel runs the column's full width; the copy around it keeps its measure. */
    .bulleted .copy {
      max-width: none;
    }

    .bulleted .copy > :not(.points, .carousel-controls) {
      max-width: 52ch;
    }

    /* Positioned, so each card's offsetLeft is measured from the track. */
    .points {
      position: relative;
      display: flex;
      gap: 12px;
      margin: 4px calc(-1 * var(--gutter)) 0;
      /* Room under the phones, since a scrolling box clips their shadow. */
      padding: 0 var(--gutter) 32px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-padding-inline: var(--gutter);
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .points::-webkit-scrollbar {
      display: none;
    }

    /* Narrower than the track, so the next card peeks in from the right. Every card is as tall
       as the tallest, and the phone sits at its foot, so the phones line up across cards. */
    .card {
      flex: 0 0 78%;
      display: grid;
      grid-template-rows: 1fr auto;
      gap: 14px;
      scroll-snap-align: start;
    }

    /* Capped by the screen's height too, so the whole card fits under the section heading. A
       single-capture section's phone matches. */
    .card :global(.phone) {
      width: min(86%, 25vh);
    }

    .step .panel :global(.phone) {
      width: min(86%, 25vh);
    }

    /* No panel behind the phone, which sits on the page with its own shadow; a tighter one than
       the frame's fits the track's room. */
    .card :global(.body),
    .step .panel :global(.body) {
      box-shadow:
        0 20px 40px -20px rgb(45 49 66 / 0.5),
        0 0 0 1px rgb(45 49 66 / 0.08);
    }

    .carousel-controls {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 8px 16px;
      margin-top: -16px;
    }

    /* A full 44px square to tap, around the same short bar. */
    .carousel-controls .mark {
      width: 44px;
      padding-inline: 8px;
    }

    .anywhere {
      padding-top: 88px;
    }
  }

  @media (max-width: 600px) {
    .features {
      --gutter: 16px;
    }
  }

  /* Last, so it outranks the width blocks' transitions of equal specificity. */
  @media (prefers-reduced-motion: reduce) {
    .stage[data-crossfade] .item,
    .mark::before,
    .points li::before,
    .point {
      transition: none;
    }
  }
</style>
