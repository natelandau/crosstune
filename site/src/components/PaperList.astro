---
// The folded tune list a player keeps in the case, drawn plainly: ruled paper, Geist, clay notes.
---

<div class="paper" data-fragment="paper-list" aria-hidden="true">
  <span class="fold"></span>
  <p>A: Cluck Old Hen</p>
  <p>Sally Goodin</p>
  <p>
    <s>Kitchen Girl</s>
  </p>
  <p>
    Breaking Up Xmas <span class="note">learn!</span>
  </p>
  <p>D: Soldier's Joy</p>
  <p>Forked Deer</p>
  <p>
    Bonaparte's <span class="note">DDAD</span>
  </p>
  <p>G: Sandy River Belle</p>
  <p class="note">ask Ann for recording</p>
</div>

<style>
  .paper {
    position: relative;
    width: 15em;
    height: 20.5em;
    padding: 1.3em 1.2em;
    border: 1px solid #d8d9de;
    background-color: #fff;
    background-image: repeating-linear-gradient(#fff 0 1.7em, #d3d9e6 1.7em calc(1.7em + 1px));
    background-position: 0 1.1em;
    box-shadow: 0 1em 2em -1.2em rgb(45 49 66 / 0.5);
    rotate: -6deg;
  }

  .fold {
    position: absolute;
    inset-inline: 0;
    top: 50%;
    border-top: 1px dashed #cfd1d8;
  }

  p {
    margin: 0;
    color: #555a6b;
    font-size: 0.92em;
    line-height: calc(1.7em / 0.92);
    white-space: nowrap;
  }

  s {
    text-decoration-color: var(--clay);
    text-decoration-thickness: 1.5px;
  }

  .note {
    color: var(--clay);
    font-size: 0.85em;
  }

  p.note {
    font-size: 0.8em;
    line-height: calc(1.7em / 0.8);
  }
</style>
