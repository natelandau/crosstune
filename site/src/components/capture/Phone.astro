---
import Capture from './Capture.astro'
import { PHONE_SCREEN, type Poster } from './captures'

// Name a capture with its description, or leave both out to fill the screen from the default slot.
type Props = ({ name: string; alt: string } | { name?: undefined; alt?: undefined }) & {
  /** Frame width in CSS pixels; the frame shrinks to fit a narrower parent. */
  width?: number
  /** Passed to `Capture`: how a clip's poster loads. */
  poster?: Poster
  /** Passed to `Capture`: a still's rendered widths across layouts. */
  sizes?: string
}

const { name, alt, width = 300, poster, sizes } = Astro.props
const ratio = PHONE_SCREEN.width / PHONE_SCREEN.height
---

<div class="phone" style={`--w: ${width}px; --ratio: ${ratio}`}>
  <div class="body">
    <div class="screen">
      {name ? (
        <Capture name={name} alt={alt} width={width} poster={poster} sizes={sizes} />
      ) : (
        <slot />
      )}
    </div>
  </div>
</div>

<style>
  .phone {
    width: min(var(--w), 100%);
    container-type: inline-size;
  }
  .body {
    position: relative;
    aspect-ratio: var(--ratio);
    border-radius: 16cqw;
    background: var(--jet);
    padding: 3.5cqw;
    box-shadow:
      0 40px 80px -30px rgb(45 49 66 / 0.45),
      0 0 0 1px rgb(45 49 66 / 0.08);
  }
  .screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 13cqw;
    overflow: hidden;
    background: var(--jet);
  }
  .screen :global(.capture) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* A lazy poster sits under its clip, which is transparent until it has a frame. */
  .screen :global(.poster) {
    position: absolute;
    inset: 0;
  }
  .screen :global(picture) {
    display: block;
    height: 100%;
  }
</style>
