---
import Capture from './Capture.astro'

interface Props {
  name: string
  alt: string
  width?: number
  /** Passed to `Capture`: the still's rendered widths across layouts. */
  sizes?: string
}

const { name, alt, width = 280, sizes } = Astro.props
---

<div class="android" style={`--w: ${width}px`}>
  <div class="body">
    <div class="screen">
      <Capture name={name} alt={alt} width={width} sizes={sizes} />
    </div>
    <span class="camera" aria-hidden="true"></span>
  </div>
</div>

<style>
  .android {
    width: min(var(--w), 100%);
    container-type: inline-size;
  }
  .body {
    position: relative;
    aspect-ratio: 1082 / 2202;
    border-radius: 9cqw;
    background: var(--jet);
    padding: 2.8cqw;
    box-shadow:
      0 40px 80px -30px rgb(45 49 66 / 0.45),
      0 0 0 1px rgb(45 49 66 / 0.08);
  }
  .screen {
    width: 100%;
    height: 100%;
    border-radius: 6.5cqw;
    overflow: hidden;
    background: var(--jet);
  }
  .screen :global(.capture) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .screen :global(picture) {
    display: block;
    height: 100%;
  }
  .camera {
    position: absolute;
    top: 5cqw;
    left: 50%;
    width: 3.6cqw;
    aspect-ratio: 1;
    transform: translateX(-50%);
    border-radius: 50%;
    background: #000;
    box-shadow: 0 0 0 0.6cqw rgb(255 255 255 / 0.06);
  }
</style>
