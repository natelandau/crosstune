---
import Capture from './Capture.astro'

interface Props {
  name: string
  alt: string
  width?: number
  /** Passed to `Capture`: the still's rendered widths across layouts. */
  sizes?: string
}

const { name, alt, width, sizes } = Astro.props
---

<div class="window">
  <div class="bar" aria-hidden="true">
    <span class="dot"></span>
    <span class="dot"></span>
    <span class="dot"></span>
    <span class="address"></span>
  </div>
  <Capture name={name} alt={alt} width={width} sizes={sizes} />
</div>

<style>
  .window {
    overflow: hidden;
    border-radius: 14px;
    background: #fff;
    box-shadow:
      0 40px 80px -30px rgb(45 49 66 / 0.35),
      0 0 0 1px rgb(45 49 66 / 0.1);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    background: var(--mist);
    border-bottom: 1px solid var(--rule);
  }
  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--alabaster);
  }
  .dot:first-child {
    background: var(--slate);
  }
  .address {
    flex: 1;
    max-width: 320px;
    height: 20px;
    margin-inline: 16px auto;
    border-radius: 999px;
    background: var(--alabaster);
    opacity: 0.6;
  }
</style>
