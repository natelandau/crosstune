---
import type { ImageMetadata } from 'astro'
import { Picture, getImage } from 'astro:assets'
import { getCapture, type Poster } from './captures'

interface Props {
  name: string
  /** Describes the capture for assistive tech; the surrounding frame is decoration. */
  alt: string
  /** Rendered width in CSS pixels, used to size the poster and the still's srcset. */
  width?: number
  /** The still's rendered width across layouts; `width` in pixels when absent. */
  sizes?: string
  /** Renders a clip's poster as an `<img>` under the video instead of the `poster` attribute. */
  poster?: Poster
  /**
   * Leaves the image's URLs in `data-src` and `data-srcset` for a script to set, for a capture
   * stacked under others in one spot, where lazy loading would fetch them all at once.
   */
  defer?: boolean
}

const { name, alt, width, sizes, poster: posterImage, defer = false } = Astro.props
const capture = getCapture(name)
const wide = capture.device === 'browser' || capture.device === 'ipad' || capture.device === 'mac'
const shown = width ?? (wide ? 960 : 360)
const image = capture.asset
if (typeof image === 'string') throw new Error(`Image for ${name} is not an image asset`)

let poster: string | undefined
if (capture.kind === 'clip') {
  // The manifest's width, never the image's own: reading any field of imported image metadata
  // marks the original as used, and the build then ships the full-size PNG.
  const posterWidth = Math.min(shown * 2, capture.width)
  poster = (await getImage({ src: image, format: 'webp', width: posterWidth })).src
}
const widths = [shown, shown * 2].filter((w) => w <= capture.width)
const sourceSizes = sizes ?? `${shown}px`

// A deferred still is built by hand, since Picture writes its URLs only to src and srcset.
const srcset = async (format: 'avif' | 'webp') =>
  (await Promise.all(widths.map((w) => getImage({ src: image, format, width: w }))))
    .map((built, i) => `${built.src} ${widths[i]}w`)
    .join(', ')
const deferredStill =
  capture.kind === 'still' && defer
    ? {
        avif: await srcset('avif'),
        webp: await srcset('webp'),
        fallback: (await getImage({ src: image, format: 'webp', width: widths[0] })).src,
      }
    : undefined
---

{capture.kind === 'clip' && (posterImage || defer) && (
  <img
    class="capture poster"
    src={defer ? undefined : poster}
    data-src={defer ? poster : undefined}
    alt=""
    width={capture.width}
    height={capture.height}
    loading={posterImage === 'lazy' ? 'lazy' : defer ? undefined : 'eager'}
    fetchpriority={posterImage === 'high' || posterImage === 'low' ? posterImage : undefined}
    decoding="async"
  />
)}
{capture.kind === 'clip' && (
  <video
    class="capture"
    data-capture={name}
    data-src={capture.src as string}
    poster={posterImage || defer ? undefined : poster}
    width={capture.width}
    height={capture.height}
    aria-label={alt}
    muted
    playsinline
    loop
    preload="none"
  />
)}
{deferredStill && (
  <picture>
    <source data-srcset={deferredStill.avif} type="image/avif" sizes={sourceSizes} />
    <source data-srcset={deferredStill.webp} type="image/webp" sizes={sourceSizes} />
    <img
      class="capture"
      data-src={deferredStill.fallback}
      data-srcset={deferredStill.webp}
      alt={alt}
      sizes={sourceSizes}
      width={capture.width}
      height={capture.height}
      decoding="async"
    />
  </picture>
)}
{capture.kind === 'still' && !defer && (
  <Picture
    class="capture"
    src={capture.src as ImageMetadata}
    alt={alt}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    widths={widths}
    sizes={sourceSizes}
  />
)}
