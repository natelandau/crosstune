---
import KeyPill from './fragments/KeyPill.astro'
import Phone from './fragments/Phone.astro'
import TuneRow from './fragments/TuneRow.astro'
---

<div class="catalog" data-fragment="phone-catalog" aria-hidden="true">
  <Phone>
    <p class="title">Tunes</p>
    <div class="group">
      <KeyPill name="A" />
    </div>
    <TuneRow name="Cluck Old Hen" detail="Reel, AEAE" status="known" />
    <TuneRow name="Sally Goodin" detail="Breakdown, AEAE" status="known" />
    <TuneRow name="Breaking Up Christmas" detail="Reel, AEAE" status="learning" />
    <div class="group">
      <KeyPill name="D" />
    </div>
    <TuneRow name="Soldier's Joy" detail="Reel, GDAE" status="known" />
    <TuneRow name="Forked Deer" detail="Reel, GDAE" status="known" />
    <TuneRow name="Bonaparte's Retreat" detail="Air, DDAD" status="learning" />
  </Phone>
</div>

<style>
  .catalog {
    --screen-height: 28.6em;
  }

  .title {
    margin: 0 0 0.35em;
    font-size: 1.45em;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .group {
    padding: 0.7em 0 0.2em;
  }
</style>
