---
// Every device on the same catalog, overlapping as one arrangement. The Mac window joins once its
// capture is in the manifest, and the others make room for it.
import AndroidFrame from './capture/AndroidFrame.astro'
import BrowserFrame from './capture/BrowserFrame.astro'
import Capture from './capture/Capture.astro'
import Phone from './capture/Phone.astro'
import { hasCapture } from './capture/captures'
import { FAMILY } from './features'

type Name = (typeof FAMILY)[number]['name']

// Each device's share of the shot's width, [desktop, below 600px]; it sets both the device's
// width and its still's srcset sizes.
const SHARE: Record<Name, [number, number]> = {
  'family-mac': [0.61, 0.7],
  'family-web': [0.7, 0.8],
  'family-ipad': [0.42, 0.52],
  'family-android': [0.14, 0.2],
  'family-iphone': [0.15, 0.21],
}
const SHARE_WITH_MAC: Record<Name, [number, number]> = {
  ...SHARE,
  'family-web': [0.5, 0.58],
  'family-ipad': [0.38, 0.46],
  'family-android': [0.13, 0.18],
  'family-iphone': [0.14, 0.19],
}
// The shot spans the page column: 920px at most, less the column's side padding below that.
const COLUMN = 920

const devices = FAMILY.filter((device) => hasCapture(device.name))
const withMac = devices.some((device) => device.name === 'family-mac')
const share = withMac ? SHARE_WITH_MAC : SHARE
const width = (name: Name) => Math.round(share[name][0] * COLUMN)
const sizes = (name: Name) => {
  const [desktop, phone] = share[name]
  return [
    `(max-width: 600px) calc(${phone} * (100vw - 32px))`,
    `(max-width: ${COLUMN + 80}px) calc(${desktop} * (100vw - 80px))`,
    `${width(name)}px`,
  ].join(', ')
}
---

<div class:list={['family', { 'with-mac': withMac }]} data-family>
  {devices.map(({ name, alt }) => (
    <div
      class:list={['device', name]}
      data-device={name}
      style={`--share: ${share[name][0]}; --share-phone: ${share[name][1]}`}
    >
      {name === 'family-web' && (
        <BrowserFrame name={name} alt={alt} width={width(name)} sizes={sizes(name)} />
      )}
      {name === 'family-mac' && (
        <Capture name={name} alt={alt} width={width(name)} sizes={sizes(name)} />
      )}
      {name === 'family-ipad' && (
        <div class="tablet">
          <div class="tablet-screen">
            <Capture name={name} alt={alt} width={width(name)} sizes={sizes(name)} />
          </div>
        </div>
      )}
      {name === 'family-android' && (
        <AndroidFrame name={name} alt={alt} width={width(name)} sizes={sizes(name)} />
      )}
      {name === 'family-iphone' && (
        <Phone name={name} alt={alt} width={width(name)} sizes={sizes(name)} />
      )}
    </div>
  ))}
</div>

<style>
  .family {
    position: relative;
    aspect-ratio: 920 / 560;
    margin-top: 56px;
  }

  .device {
    position: absolute;
    width: calc(var(--share) * 100%);
    container-type: inline-size;
  }

  .device :global(.phone),
  .device :global(.android) {
    width: 100%;
  }

  .family-web {
    top: 0;
    left: 0;
  }

  .family-ipad {
    z-index: 3;
    top: 13%;
    right: 0;
  }

  .family-android {
    z-index: 3;
    bottom: 0;
    left: 5%;
  }

  .family-iphone {
    z-index: 3;
    bottom: 0;
    left: 55%;
  }

  /* The Mac takes the back left, and the browser moves behind it to the right. */
  .with-mac .family-mac {
    z-index: 2;
    top: 0;
    left: 0;
  }

  .with-mac .family-web {
    z-index: 1;
    top: 6%;
    right: 0;
    left: auto;
  }

  .with-mac .family-ipad {
    top: auto;
    bottom: 0;
    right: 4%;
  }

  .with-mac .family-iphone {
    left: 41%;
  }

  /* The Mac capture is a whole window with its own title bar, so it needs no frame of its own. */
  .family-mac :global(.capture) {
    border-radius: 1.4cqw;
    filter: drop-shadow(0 30px 40px rgb(45 49 66 / 0.3));
  }

  .tablet {
    padding: 2.6cqw;
    border-radius: 4.5cqw;
    background: var(--jet);
    box-shadow:
      0 40px 80px -30px rgb(45 49 66 / 0.45),
      0 0 0 1px rgb(45 49 66 / 0.08);
  }

  .tablet-screen {
    overflow: hidden;
    border-radius: 2cqw;
  }

  @media (max-width: 600px) {
    .device {
      width: calc(var(--share-phone) * 100%);
    }

    .family {
      aspect-ratio: 358 / 300;
      margin-top: 40px;
    }

    .family-ipad {
      top: 20%;
    }

    .family-android {
      left: 2%;
    }

    .family-iphone {
      left: 50%;
    }

    .with-mac .family-ipad {
      right: 0;
    }

    .with-mac .family-iphone {
      left: 34%;
    }
  }
</style>
