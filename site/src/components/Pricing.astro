---
import {
  INACTIVE_RULE,
  KEEP_DETAIL,
  KEEP_PROMISE,
  PLAN_FREE,
  PLAN_PREMIUM,
  PRICE_LINE,
  PRICING_LEDE,
  PRICING_TITLE,
} from './pricing'
---

<section id="pricing" class="pricing column" aria-labelledby="pricing-title">
  <h2 id="pricing-title">{PRICING_TITLE}</h2>
  <p class="lede">{PRICING_LEDE}</p>

  <div class="plans">
    <div class="plan">
      <h3>{PLAN_FREE.name}</h3>
      <p class="sub">{PLAN_FREE.tagline}</p>
      <ul>
        {PLAN_FREE.bullets.map((bullet) => (
          <li>{bullet}</li>
        ))}
      </ul>
    </div>
    <div class="plan premium">
      <h3>{PLAN_PREMIUM.name}</h3>
      <p class="price">{PRICE_LINE}</p>
      <p class="sub">{PLAN_PREMIUM.tagline}</p>
      <ul>
        {PLAN_PREMIUM.bullets.map((bullet) => (
          <li>{bullet}</li>
        ))}
      </ul>
    </div>
  </div>

  <p class="keep">
    <strong>{KEEP_PROMISE}</strong> {KEEP_DETAIL}
  </p>
  <p class="inactive">{INACTIVE_RULE}</p>
</section>

<style>
  .pricing {
    padding-block: var(--section-pad);
  }

  h2 {
    max-width: 20ch;
    margin: 0;
    font-size: var(--section-size);
    font-weight: var(--section-weight);
    line-height: 1.02;
    letter-spacing: var(--tracking);
    text-wrap: balance;
  }

  .lede {
    max-width: 48ch;
    margin: 20px 0 0;
    color: var(--slate);
    font-size: 1.1875rem;
  }

  .plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 40px;
  }

  .plan {
    display: grid;
    gap: 14px;
    align-content: start;
    min-width: 0;
    padding: 28px;
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 0 0 1px var(--rule);
  }

  .plan.premium {
    background: var(--jet);
    box-shadow: none;
    color: var(--mist);
  }

  h3 {
    margin: 0;
    font-size: var(--plan-size);
    font-weight: var(--plan-weight);
    line-height: 1.1;
    letter-spacing: var(--tracking);
  }

  .sub,
  .price {
    margin: 0;
  }

  .sub {
    color: var(--slate);
  }

  .price {
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.3;
    font-variant-numeric: tabular-nums;
  }

  .premium .sub {
    color: var(--alabaster);
  }

  ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding-left: 1.1em;
  }

  .premium li::marker {
    color: var(--alabaster);
  }

  .keep,
  .inactive {
    max-width: 62ch;
    margin: 28px 0 0;
    text-wrap: pretty;
  }

  .inactive {
    margin-top: 16px;
    color: var(--slate);
  }

  .keep strong {
    font-weight: 650;
  }
</style>
