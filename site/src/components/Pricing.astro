---
import { JOIN_WAITLIST, WAITLIST_ID } from './actions'
import { BILLING, PLAN_FREE, PLAN_PREMIUM, PRICING_LEDE, PRICING_TITLE } from './pricing'
---

<section class="pricing" id="pricing" aria-labelledby="pricing-title">
  <div class="wrap">
    <h2 id="pricing-title">{PRICING_TITLE}</h2>
    <p class="lede">{PRICING_LEDE}</p>
    <fieldset class="billing">
      <legend class="visually-hidden">Billing period</legend>
      {Object.entries(BILLING).map(([period, { label }], i) => (
        <label>
          <input type="radio" name="billing" value={period} checked={i === 0} />
          <span>{label}</span>
        </label>
      ))}
    </fieldset>
    <div class="plans">
      <article class="plan">
        <h3>{PLAN_FREE.name}</h3>
        <p class="for">{PLAN_FREE.tagline}</p>
        <p class="price">
          <b>{PLAN_FREE.price}</b> <span>{PLAN_FREE.per}</span>
        </p>
        <ul>
          {PLAN_FREE.bullets.map((bullet) => (
            <li>{bullet}</li>
          ))}
        </ul>
        <a class="button quiet" href={`#${WAITLIST_ID}`}>
          {JOIN_WAITLIST}
        </a>
      </article>
      <article class="plan pro">
        <h3>{PLAN_PREMIUM.name}</h3>
        <p class="for">{PLAN_PREMIUM.tagline}</p>
        {Object.entries(BILLING).map(([period, { price, per, saving }]) => (
          <p class="price" data-period={period}>
            <b>{price}</b> <span>{per}</span>
            {saving && <em>{saving}</em>}
          </p>
        ))}
        <ul>
          {PLAN_PREMIUM.bullets.map((bullet) => (
            <li>{bullet}</li>
          ))}
        </ul>
        <a class="button" href={`#${WAITLIST_ID}`}>
          {JOIN_WAITLIST}
        </a>
      </article>
    </div>
  </div>
</section>

<style>
  .pricing {
    padding-block: var(--section-pad);
    background: var(--mist);
  }

  h2 {
    max-width: 17ch;
    font-size: var(--h2);
    font-weight: 750;
    line-height: 1.04;
    letter-spacing: -0.03em;
  }

  .lede {
    max-width: 52ch;
    margin-top: 20px;
    color: var(--ink-2);
  }

  .billing {
    display: inline-flex;
    margin: 32px 0 0;
    padding: 4px;
    border: 0;
    border-radius: 999px;
    background: var(--alabaster);
  }

  .billing label {
    position: relative;
  }

  .billing input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .billing span {
    display: block;
    padding: 8px 18px;
    border-radius: 999px;
    color: var(--ink-2);
    font-size: 15px;
    font-weight: 600;
  }

  .billing input:checked + span {
    background: var(--paper);
    color: var(--ink);
    box-shadow: 0 1px 3px rgb(29 34 48 / 0.12);
  }

  .billing input:focus-visible + span {
    outline: 3px solid var(--slate);
    outline-offset: 2px;
  }

  /* The checked period picks which Premium price shows; no script needed. */
  .pricing:has(input[value='yearly']:checked) .price[data-period='monthly'],
  .pricing:has(input[value='monthly']:checked) .price[data-period='yearly'] {
    display: none;
  }

  .plans {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    max-width: 920px;
    margin-top: 28px;
  }

  .plan {
    display: flex;
    flex-direction: column;
    padding: 32px;
    border-radius: 24px;
    background: var(--paper);
  }

  .plan.pro {
    box-shadow: inset 0 0 0 2px var(--coral);
  }

  h3 {
    font-size: var(--h3);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .for {
    margin-top: 4px;
    color: var(--ink-2);
  }

  .price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px;
    margin-top: 22px;
  }

  .price b {
    font-size: 44px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .price span {
    color: var(--ink-2);
    font-size: 16px;
  }

  .price em {
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--coral-wash);
    color: var(--on-coral-wash);
    font-size: 13px;
    font-style: normal;
    font-weight: 700;
  }

  ul {
    display: grid;
    gap: 10px;
    margin: 24px 0 28px;
    padding: 0;
    font-size: 16px;
    list-style: none;
  }

  li {
    position: relative;
    padding-left: 26px;
    line-height: 1.4;
  }

  li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 12px;
    height: 2px;
    border-radius: 1px;
    background: var(--silver);
  }

  .pro li::before {
    background: var(--coral);
  }

  .plan .button {
    align-self: flex-start;
    margin-top: auto;
  }

  @media (max-width: 760px) {
    .plans {
      grid-template-columns: 1fr;
    }

    .plan {
      padding: 26px;
    }
  }
</style>
