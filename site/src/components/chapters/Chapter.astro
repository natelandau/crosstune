---
// One use case: a short heading, one sentence, and a demo the visitor can operate.
import type { CHAPTERS } from './chapters'

interface Props {
  chapter: (typeof CHAPTERS)[number]
  tone?: 'white' | 'mist' | 'jet'
}

const { chapter, tone = 'white' } = Astro.props
const { id, title, sentence } = chapter
---

<section id={id} class:list={['chapter', tone]} aria-labelledby={`${id}-title`}>
  <div class="column">
    <h3 id={`${id}-title`}>{title}</h3>
    <p class="sentence">{sentence}</p>
    <div class="demo">
      <slot />
    </div>
  </div>
</section>

<style>
  .chapter {
    padding-block: 96px;
    scroll-margin-top: 16px;
  }

  .mist {
    background: var(--mist);
  }

  .jet {
    background: var(--jet);
    color: #fff;
  }

  h3 {
    max-width: 20ch;
    margin: 0;
    font-size: clamp(1.9rem, 1.4rem + 1.8vw, 2.75rem);
    font-weight: 650;
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .sentence {
    max-width: 44ch;
    margin: 16px 0 0;
    color: var(--slate);
    font-size: 1.125rem;
  }

  .jet .sentence {
    color: var(--alabaster);
  }

  .demo {
    margin-top: 44px;
  }

  @media (max-width: 600px) {
    .chapter {
      padding-block: 64px;
    }

    .demo {
      margin-top: 32px;
    }
  }
</style>
