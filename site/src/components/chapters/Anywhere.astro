---
// The "No signal needed" picture: the campsite, and a phone with no service holding an edit
// until it is back in range.
import { Picture } from 'astro:assets'
import campsite from '../../assets/campsite.jpg'
import KeyPill from '../fragments/KeyPill.astro'
import Phone from '../fragments/Phone.astro'
import TuneRow from '../fragments/TuneRow.astro'
---

<figure class="scene">
  <div class="art">
    <Picture
      src={campsite}
      formats={['avif', 'webp']}
      widths={[480, 720, 1120, 1600]}
      sizes="(min-width: 1000px) 920px, calc(100vw - 32px)"
      alt="Friends around a campfire at night, with tents lit among the trees behind them."
    />
    <div class="phone-slot" data-fragment="offline-phone" aria-hidden="true">
      <Phone signal="No Service">
        <p class="title">Tunes</p>
        <span class="badge">1 change waiting</span>
        <div class="group">
          <KeyPill name="A" />
        </div>
        <TuneRow name="Cluck Old Hen" status="known" />
        <TuneRow name="Breaking Up Christmas" status="known" />
        <TuneRow name="Sally Goodin" status="known" />
        <div class="player">
          <span class="pause"></span>
          <span class="now">Porch, Sunday</span>
          <span class="progress"></span>
        </div>
      </Phone>
    </div>
  </div>
  <figcaption>Photo by Ivan Dimitrov on Unsplash</figcaption>
</figure>

<style>
  .scene {
    margin: 0;
  }

  .art {
    position: relative;
  }

  /*
   * The crop keeps the fire and the circle of people left and the tents behind; the phone
   * sits over the dark trees top right, where it covers no one.
   */
  .art :global(img) {
    display: block;
    width: 100%;
    height: 440px;
    border-radius: 24px;
    object-fit: cover;
    object-position: 30% 70%;
  }

  .phone-slot {
    position: absolute;
    top: -40px;
    right: 48px;
    font-size: 12px;
    --screen-height: 21em;
  }

  .title {
    margin: 0 0 0.2em;
    font-size: 1.45em;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .badge {
    display: inline-block;
    margin-bottom: 0.4em;
    padding: 0.2em 0.7em;
    border-radius: 999px;
    background: #f6ebe8;
    color: var(--clay-ink);
    font-size: 0.72em;
    font-weight: 600;
  }

  .group {
    padding: 0.2em 0;
  }

  .player {
    display: flex;
    align-items: center;
    gap: 0.6em;
    margin-top: 0.9em;
    padding: 0.6em 0.7em;
    border-radius: 0.8em;
    background: var(--mist);
    font-size: 0.8em;
    font-weight: 600;
  }

  /* Pause bars: the recording is playing. */
  .pause {
    flex: none;
    width: 0.75em;
    height: 0.8em;
    border-inline: 0.25em solid var(--slate);
  }

  .now {
    white-space: nowrap;
  }

  .progress {
    flex: 1;
    height: 0.25em;
    border-radius: 1em;
    background: linear-gradient(90deg, var(--coral) 45%, var(--silver) 45%);
  }

  figcaption {
    margin-top: 10px;
    color: var(--slate-2);
    font-size: 0.8rem;
  }

  @media (max-width: 760px) {
    .art :global(img) {
      height: 300px;
      object-position: 25% 70%;
    }

    .phone-slot {
      top: -28px;
      right: 12px;
      font-size: 8.5px;
    }
  }
</style>
