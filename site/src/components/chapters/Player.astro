---
// The practice demo: a real recording the visitor can play, slow, shift, and loop. The built
// page draws the player at rest; the script reveals the controls and runs it.
import peaks from '../../demos/peaks.json'
import {
  DETECTED_KEY,
  formatTime,
  INITIAL_LOOP,
  PITCH,
  PITCH_DOWN,
  PITCH_UP,
  PLAY,
  PLAYER_REST,
  REST_LINE,
  SPEED,
} from '../../demos/practice'

const DURATION = 30
const fraction = (seconds: number) => (seconds / DURATION).toFixed(4)
const bars = (peaks as number[]).map((p) => `--h: ${Math.max(0.06, p).toFixed(2)}`)
---

<div class="player" data-player data-duration={DURATION}>
  <audio src="/audio/bibb-county-hoedown.m4a" preload="none" data-audio></audio>
  <div class="head">
    <div class="title">
      <span class="name">Bibb County Hoedown</span>
      <span class="by">Strung Out String Band</span>
    </div>
    <span class="detected">
      <span class="pill">{DETECTED_KEY}</span>
      Key detected
    </span>
  </div>

  <div
    class="track"
    data-track
    style={`--a: ${fraction(INITIAL_LOOP.a)}; --b: ${fraction(INITIAL_LOOP.b)}; --at: 0`}
  >
    <div class="band" aria-hidden="true"></div>
    <div class="bars" aria-hidden="true">
      {bars.map((style) => (
        <span style={style} />
      ))}
    </div>
    <div class="bars played" aria-hidden="true">
      {bars.map((style) => (
        <span style={style} />
      ))}
    </div>
    <div class="playhead" aria-hidden="true"></div>
    {(['a', 'b'] as const).map((handle) => (
      <span
        class:list={['handle', handle]}
        data-handle={handle}
        role="slider"
        tabindex="0"
        aria-label={handle === 'a' ? 'Loop start' : 'Loop end'}
        aria-valuemin="0"
        aria-valuemax={DURATION}
        aria-valuenow={INITIAL_LOOP[handle]}
        aria-valuetext={formatTime(INITIAL_LOOP[handle])}
      >
        <span class="flag" aria-hidden="true">
          {handle.toUpperCase()}
        </span>
      </span>
    ))}
  </div>
  <div class="times">
    <span data-now>0:00</span>
    <span>{formatTime(DURATION)}</span>
  </div>

  <div class="controls" data-controls hidden>
    <button type="button" class="play" data-play aria-label={PLAY}>
      <span class="glyph" aria-hidden="true"></span>
    </button>
    <button type="button" class="toggle" data-loop aria-pressed="false">
      Loop A-B
    </button>
    <div class="speed">
      <label for="practice-speed">Speed</label>
      <input
        id="practice-speed"
        type="range"
        min={SPEED.min}
        max={SPEED.max}
        step={SPEED.step}
        value={SPEED.initial}
        data-speed
      />
      <output for="practice-speed" data-speed-value>
        {SPEED.initial}%
      </output>
    </div>
    <div class="pitch" role="group" aria-labelledby="practice-pitch">
      <span id="practice-pitch">Pitch</span>
      <button type="button" class="step minus" data-pitch="-1" aria-label={PITCH_DOWN}></button>
      <output data-pitch-value aria-live="off">
        {PITCH.initial}
      </output>
      <button type="button" class="step plus" data-pitch="1" aria-label={PITCH_UP}></button>
    </div>
  </div>

  <p class="demo-caption" aria-live="polite" data-caption>
    {PLAYER_REST}
  </p>
  <p class="rest">{REST_LINE}</p>
</div>

<style>
  .player {
    --ink: #fff;
    --quiet: var(--silver);
    --ground: rgb(255 255 255 / 0.06);
    --line: rgb(255 255 255 / 0.14);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 12px 24px;
  }

  .title {
    display: grid;
  }

  .name {
    font-size: 1.375rem;
    font-weight: 650;
    letter-spacing: -0.015em;
  }

  .by {
    color: var(--quiet);
  }

  .detected {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--quiet);
    font-size: 0.95rem;
  }

  .pill {
    padding: 0.2em 0.75em;
    border-radius: 999px;
    background: var(--key-9-bg);
    color: var(--key-9-ink);
    font-weight: 650;
  }

  /* --a, --b, and --at are fractions of the clip, set by the script; --inset is where the bars
     start and end inside the track. */
  .track {
    --inset: 20px;
    --run: calc(100% - 2 * var(--inset));
    position: relative;
    height: 168px;
    margin-top: 28px;
    border-radius: 16px;
    background: var(--ground);
    touch-action: none;
    cursor: pointer;
  }

  .bars {
    position: absolute;
    inset: 28px var(--inset) 16px;
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .bars span {
    flex: 1;
    height: calc(var(--h) * 100%);
    border-radius: 2px;
    background: rgb(255 255 255 / 0.28);
  }

  .played {
    clip-path: inset(0 calc((1 - var(--at)) * 100%) 0 0);
  }

  .played span {
    background: #fff;
  }

  .band {
    position: absolute;
    inset-block: 0;
    left: calc(var(--inset) + var(--run) * var(--a));
    width: calc(var(--run) * (var(--b) - var(--a)));
    background: rgb(239 131 84 / 0.1);
  }

  .looping .band {
    background: rgb(239 131 84 / 0.24);
  }

  .playhead {
    position: absolute;
    inset-block: 12px;
    left: calc(var(--inset) + var(--run) * var(--at));
    width: 2px;
    margin-left: -1px;
    background: #fff;
  }

  .handle.a {
    left: calc(var(--inset) + var(--run) * var(--a));
  }

  .handle.b {
    left: calc(var(--inset) + var(--run) * var(--b));
  }

  .handle {
    position: absolute;
    inset-block: 0;
    width: 44px;
    margin-left: -22px;
    cursor: ew-resize;
  }

  .handle::before {
    content: '';
    position: absolute;
    inset-block: 0;
    left: 21px;
    width: 2px;
    background: var(--coral);
  }

  .flag {
    position: absolute;
    top: 0;
    left: 50%;
    translate: -50% 0;
    padding: 2px 8px;
    border-radius: 0 0 6px 6px;
    background: var(--coral);
    color: var(--jet);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .handle:focus-visible {
    outline: 2px solid #fff;
    outline-offset: -2px;
    border-radius: 6px;
  }

  .times {
    display: flex;
    justify-content: space-between;
    margin-top: 8px;
    color: var(--quiet);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 24px;
  }

  .player :focus-visible {
    outline-color: #fff;
  }

  .play {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border: 0;
    border-radius: 50%;
    background: var(--coral);
    cursor: pointer;
  }

  .play .glyph {
    margin-left: 4px;
    border-left: 18px solid var(--jet);
    border-block: 11px solid transparent;
  }

  .play[aria-label='Pause'] .glyph {
    width: 18px;
    height: 20px;
    margin-left: 0;
    border-block: 0;
    border-inline: 6px solid var(--jet);
  }

  .toggle {
    min-height: 44px;
    padding: 0 18px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--ink);
    font: inherit;
    font-weight: 500;
    cursor: pointer;
  }

  .toggle[aria-pressed='true'] {
    background: var(--coral);
    box-shadow: none;
    color: var(--jet);
  }

  .speed,
  .pitch {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  label,
  #practice-pitch {
    color: var(--quiet);
  }

  input[type='range'] {
    width: 160px;
    accent-color: var(--coral);
  }

  output {
    min-width: 3.2ch;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  .step {
    position: relative;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--line);
    cursor: pointer;
  }

  .step::before,
  .plus::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 14px;
    height: 2px;
    translate: -50% -50%;
    background: #fff;
  }

  .plus::after {
    rotate: 90deg;
  }

  .step:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .demo-caption {
    margin-top: 24px;
    color: #fff;
    font-size: 1.125rem;
    font-weight: 500;
  }

  .rest {
    max-width: 52ch;
    margin: 8px 0 0;
    color: var(--quiet);
  }

  @media (max-width: 600px) {
    .track {
      --inset: 12px;
      height: 128px;
    }

    .bars {
      gap: 1px;
    }

    .controls {
      gap: 16px;
    }

    input[type='range'] {
      flex: 1;
      width: auto;
    }

    .speed {
      flex: 1 1 100%;
    }
  }
</style>
