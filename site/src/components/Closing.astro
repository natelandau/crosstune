---
import JoinForm from './JoinForm.astro'
import { WAITLIST_ID } from './actions'
import { CLOSING_LEDE, CLOSING_TITLE } from './closing'
---

<section id={WAITLIST_ID} class="closing wrap" aria-labelledby="waitlist-title">
  <div class="panel">
    <div>
      <h2 id="waitlist-title">{CLOSING_TITLE}</h2>
      <p>{CLOSING_LEDE}</p>
    </div>
    <JoinForm id="closing" />
  </div>
</section>

<style>
  .closing {
    padding-bottom: clamp(48px, 6vw, 80px);
    scroll-margin-top: 84px;
  }

  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 460px);
    gap: 40px;
    align-items: end;
    padding: clamp(40px, 6vw, 80px);
    border-radius: 32px;
    background: var(--coral-wash);
  }

  h2 {
    max-width: 13ch;
    font-size: var(--h2);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.035em;
  }

  p {
    max-width: 40ch;
    margin-top: 16px;
    color: var(--slate);
  }

  .panel :global(.note) {
    color: var(--slate);
  }

  @media (max-width: 860px) {
    .panel {
      grid-template-columns: 1fr;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
      border-radius: 0;
    }
  }
</style>
