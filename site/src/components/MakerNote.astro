---
import { NATE_EMAIL } from './actions'
import { MAKER_BAND, MAKER_INVITE, MAKER_STORY, MAKER_TITLE } from './maker'
---

<section class="column" aria-labelledby="maker-title">
  <div class="note">
    <h2 id="maker-title">{MAKER_TITLE}</h2>
    <figure>
      <blockquote>
        <p>
          {MAKER_STORY} <a href={MAKER_BAND.url}>{MAKER_BAND.name}</a>.
        </p>
        <p>
          {MAKER_INVITE} <a href={`mailto:${NATE_EMAIL}`}>{NATE_EMAIL}</a>.
        </p>
      </blockquote>
    </figure>
  </div>
</section>

<style>
  .note {
    padding-block: var(--section-pad);
    border-top: 1px solid var(--rule);
  }

  h2 {
    margin: 0 0 32px;
    font-size: clamp(1.9rem, 1.4rem + 1.8vw, 2.75rem);
    font-weight: 650;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  p + p {
    margin-top: 0.9em;
  }

  figure,
  blockquote {
    margin: 0;
  }

  a {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  p {
    max-width: 38ch;
    margin: 0;
    font-size: clamp(1.25rem, 1rem + 1vw, 1.6rem);
    line-height: 1.45;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }
</style>
