---
import { Image } from 'astro:assets'
import nate from '../assets/nate.jpg'
import { NATE_EMAIL } from './actions'
import { MAKER_BAND, MAKER_INVITE, MAKER_PHOTO_ALT, MAKER_STORY, MAKER_TITLE } from './maker'
---

<section class="maker wrap" aria-labelledby="maker-title">
  <Image class="portrait" src={nate} widths={[240, 480]} sizes="240px" alt={MAKER_PHOTO_ALT} />
  <div>
    <h2 id="maker-title">{MAKER_TITLE}</h2>
    <p>
      {MAKER_STORY} <a href={MAKER_BAND.url}>{MAKER_BAND.name}</a>.
    </p>
    <p>
      {MAKER_INVITE} <a href={`mailto:${NATE_EMAIL}`}>{NATE_EMAIL}</a>.
    </p>
  </div>
</section>

<style>
  .maker {
    display: grid;
    grid-template-columns: 240px minmax(0, 640px);
    gap: 56px;
    align-items: start;
    padding-block: var(--section-pad);
  }

  .portrait {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 22px;
  }

  h2 {
    font-size: clamp(28px, 3vw, 38px);
    font-weight: 750;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  p {
    margin-top: 18px;
    font-size: 19px;
    line-height: 1.6;
  }

  @media (max-width: 760px) {
    .maker {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .portrait {
      width: 180px;
    }
  }
</style>
