    "default_settings": "Are the default settings the ones people keep?",
    "facet_retention": "Does using more tune fields go with better retention?",
    "hands_free_control": "Do people control playback without touching the app?",
    "accessibility_reach": "How many people use assistive technology, and do they stay?"
