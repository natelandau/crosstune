# Settings for the tracking plan recipes. Copy this file to analytics/.env.
# Only `just analytics::sync` and `just analytics::audit` read it; `check` and
# `test` need nothing here.

# ==== PostHog ================================================================

# A personal API key labeled "crosstune tracking plan", limited to the Crosstune
# project with the scopes Event definition: Write, Property definition: Write,
# and Query: Read. It is not the API's person delete key.
POSTHOG_DEFINITIONS_KEY=

# The Crosstune project's ID, from the project settings page.
POSTHOG_PROJECT_ID=
