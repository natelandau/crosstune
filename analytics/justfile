# Recipes for the analytics tracking plan. Loaded as the `analytics` module by the root
# justfile and run from this directory: `just analytics::check` from anywhere in the repository.

import '../scripts/settings.just'

# Runs a lint or test gate through gate-cache when it is installed
gate := "../scripts/gate-cache.sh"
# The tracked files every gate here reads, as gate-cache paths: the module, its gate script,
# and the shared settings. Each gate adds the other paths it reads.
paths := "--path analytics/ --path scripts/gate-cache.sh --path scripts/settings.just"
# The root tooling environment that `uv run --project ..` runs the checker in
uv_paths := "--path pyproject.toml --path uv.lock --path .python-version"

[default]
_default:
    @just --list analytics

# Check the tracking plan for problems
[group('lint')]
check:
    {{ gate }} analytics-check {{ paths }} {{ uv_paths }} uv run --project .. python plan.py check

# Run the checker's tests and the plan's own test
[group('test')]
[arg("args", help="Arguments for pytest")]
test *args:
    {{ gate }} analytics-test {{ paths }} {{ uv_paths }} --argc "$#" --junit .cache/junit/analytics-test uv run --project .. python -m pytest test_plan.py -q --junitxml=.cache/junit/analytics-test/pytest.xml "$@"

# Push the plan's event descriptions to PostHog
[group('analytics')]
sync:
    uv run --project .. python plan.py sync

# List events missing from the plan or from PostHog
[group('analytics')]
audit:
    uv run --project .. python plan.py audit
