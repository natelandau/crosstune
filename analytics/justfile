# Recipes for the analytics tracking plan. Loaded as the `analytics` module by the root
# justfile and run from this directory: `just analytics::check` from anywhere in the repository.

import '../scripts/settings.just'

# Runs a lint or test gate through gate-cache when it is installed
gate := "../scripts/gate-cache.sh"

[default]
_default:
    @just --list analytics

# Check the tracking plan for problems
[group('lint')]
check:
    {{ gate }} analytics-check uv run --project .. python plan.py check

# Run the checker's tests and the plan's own test
[group('test')]
[arg("args", help="Arguments for pytest")]
test *args:
    {{ gate }} analytics-test --argc "$#" uv run --project .. python -m pytest test_plan.py -q "$@"

# Push the plan's event descriptions to PostHog
[group('analytics')]
sync:
    uv run --project .. python plan.py sync

# List events missing from the plan or from PostHog
[group('analytics')]
audit:
    uv run --project .. python plan.py audit
