# Settings for the API. `just api::setup` copies this file to api/.env. Every
# name the API reads is here, including the ones a host sets, which stay
# commented out in the last section. docs/hosting.md has the hosted values.

# ==== Runtime ================================================================

# Optional. The environment this API runs as. It tags Sentry events and decides
# which bucket and key prefix the storage settings may use. Hosted APIs use
# production, development, or pr-<number>.
CROSSTUNE_ENVIRONMENT=development

# Optional. When true, logs are plain text at DEBUG level. When false, logs are
# JSON at INFO level.
CROSSTUNE_DEBUG=false

# ==== Database ===============================================================

# Optional. The Postgres connection string. The default matches the database
# that compose.yml starts. Hosted APIs use the connection string from Neon.
# The end-to-end suite has its own database, crosstune_e2e, in the same server.
# `just api::run-e2e` points the API at it for one run and leaves this value
# alone, and `just api::e2e-db-reset` empties it. In a worktree,
# `just api::worktree-db` sets this to the worktree's own database.
CROSSTUNE_DATABASE_URL=postgresql+asyncpg://crosstune:crosstune@localhost:5432/crosstune

# ==== Sign-in (Clerk) ========================================================

# Required. The Frontend API URL of the Clerk instance, from the Domains page in
# the Clerk Dashboard. A development instance looks like
# https://<slug>.clerk.accounts.dev.
CROSSTUNE_CLERK_ISSUER=

# Optional. A JSON list of the web origins that can send session tokens. If this
# is unset, the API accepts a token from any origin. Local development uses
# ["http://localhost:5173","http://localhost:4173"].
# CROSSTUNE_CLERK_AUTHORIZED_PARTIES=

# Optional. A regular expression for more allowed web origins. Hosted
# development uses it to accept the preview Worker URLs.
# CROSSTUNE_CLERK_AUTHORIZED_PARTY_REGEX=

# Optional. The Signing Secret of the endpoint on the Webhooks page in the Clerk
# Dashboard. If this is unset, the API rejects every Clerk webhook delivery.
# CROSSTUNE_CLERK_WEBHOOK_SECRET=

# Optional locally, required when hosted. The Secret Key of the Clerk instance,
# from the API keys page in the Clerk Dashboard (sk_test_... for development).
# The API uses it to delete a user's Clerk account when they delete their
# account. If this is unset, account deletion answers 503. The end-to-end
# suite needs it, with the same value as CLERK_SECRET_KEY in web/.env.
# CROSSTUNE_CLERK_SECRET_KEY=

# ==== Error reporting ========================================================

# Optional. The DSN of the crosstune-api project, from Project Settings > Client
# Keys (DSN) in Sentry. If this is unset, the API does not send errors to Sentry.
# CROSSTUNE_SENTRY_DSN=

# ==== Recording storage ======================================================

# Any S3-compatible store. Local work uses the RustFS that compose.yml starts,
# with the fixed credentials below; `just api::storage-setup` creates the
# bucket. Hosted APIs use Cloudflare R2. If the bucket or a key is unset, the API
# refuses upload slots with a 503. Never point local work at a hosted bucket:
# every sweep deletes what this database does not know about.

# Required for recordings. The bucket. Local work uses crosstune-local, the
# end-to-end suite crosstune-e2e, and a worktree its own crosstune-wt-<name>,
# which `just api::worktree-db` sets.
CROSSTUNE_STORAGE_BUCKET=crosstune-local

# Required for recordings. The access key pair of a token scoped to that bucket.
CROSSTUNE_STORAGE_ACCESS_KEY_ID=crosstune
CROSSTUNE_STORAGE_SECRET_ACCESS_KEY=crosstune-local-secret

# Optional. A key prefix that ends in /, so several environments can share a
# bucket. Only pull request previews set it, to pr-<number>/.
# CROSSTUNE_STORAGE_PREFIX=

# ==== Music service search ===================================================
# Search from a tune finds recordings on Apple Music and TIDAL. Without these
# values both services show only their "Search on" rows. Set all of a service's
# values or none. One key and one app serve every environment.

# Optional. The Apple Developer Team ID, from Membership details on the account
# page. Needs the key ID and private key below. Setup: docs/hosting.md.
# CROSSTUNE_APPLE_MUSIC_TEAM_ID=

# Optional. The Key ID of the MusicKit key created under Keys in Certificates,
# Identifiers & Profiles. Setup: docs/hosting.md.
# CROSSTUNE_APPLE_MUSIC_KEY_ID=

# Optional. The whole contents of the .p8 file Apple lets you download once,
# from its BEGIN line through its END line. Wrap it in double quotes and keep
# the line breaks. Setup: docs/hosting.md.
# CROSSTUNE_APPLE_MUSIC_PRIVATE_KEY=

# Optional. The Client ID and Client Secret of the app created in the Dashboard
# at developer.tidal.com. The app uses the client credentials flow only.
# Setup: docs/hosting.md.
# CROSSTUNE_TIDAL_CLIENT_ID=
# CROSSTUNE_TIDAL_CLIENT_SECRET=

# ==== Limits and tuning ======================================================

# Optional. The number of seconds the API waits for a link's page when it reads
# the page's title and metadata.
# CROSSTUNE_LINK_RESOLVE_TIMEOUT_SECONDS=5

# Optional. The number of times one user can call the link resolve route in a
# minute. Each call fetches a page from another site.
# CROSSTUNE_LINK_RESOLVES_PER_MINUTE=30

# Optional. The number of times one user can call the link search route in a
# minute. Each call queries streaming services.
# CROSSTUNE_LINK_SEARCHES_PER_MINUTE=20

# Optional. The maximum number of changes in one sync pull response.
# CROSSTUNE_PULL_PAGE_SIZE=500

# Optional. The largest request body a /v1 route accepts, in bytes (32 MiB). A full
# push batch must fit under it.
# CROSSTUNE_MAX_REQUEST_BODY_BYTES=33554432

# Optional. The per-user cap on stored bytes across recordings and scans
# (1 GiB), the largest recording upload (50 MiB), and the largest scan
# upload (5 MiB).
# CROSSTUNE_STORAGE_QUOTA_BYTES=1073741824
# CROSSTUNE_RECORDING_MAX_FILE_BYTES=52428800
# CROSSTUNE_SCAN_MAX_FILE_BYTES=5242880

# Optional. How often, in seconds, the job runner deletes the files of accounts
# and recordings that no longer exist.
# CROSSTUNE_ORPHAN_SWEEP_SECONDS=43200

# ==== Local development only =================================================

# The API refuses to start with these on a hosted environment.

# Required for local recordings. The S3 endpoint of the local RustFS. Hosted
# APIs build the R2 endpoint from CROSSTUNE_R2_ACCOUNT_ID instead.
CROSSTUNE_LOCAL_STORAGE_ENDPOINT_URL=http://localhost:9000

# Optional. Rewrites every presigned URL to this origin. Browsers reach RustFS
# through the dev server's /storage proxy, so a phone on Tailscale can upload.
CROSSTUNE_LOCAL_STORAGE_BROWSER_ENDPOINT_URL=/storage

# ==== Set by a host or CI only ===============================================

# Never set these locally. docs/hosting.md says where each one is set.

# Railway. The Cloudflare account ID, from which the API builds the R2 endpoint.
# CROSSTUNE_R2_ACCOUNT_ID=

# Railway injects the port the API listens on. The Dockerfile defaults it to
# 8000.
# PORT=

# GitHub Actions sets CI=true. The RustFS compatibility tests then fail, rather
# than skip, when RustFS is not running.
# CI=

# The Preview workflow, for `python -m crosstune.ops.preview_storage`. The
# Cloudflare account that holds the R2 buckets, the read-write token of the
# preview bucket, and the read-only token of the development bucket that seeds
# a preview.
# CLOUDFLARE_ACCOUNT_ID=
# STORAGE_ACCESS_KEY_ID_PREVIEW=
# STORAGE_SECRET_ACCESS_KEY_PREVIEW=
# STORAGE_READ_ACCESS_KEY_ID_DEVELOPMENT=
# STORAGE_READ_SECRET_ACCESS_KEY_DEVELOPMENT=
