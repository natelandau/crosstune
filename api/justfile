# Recipes for the API. Loaded as the `api` module by the root justfile and run
# from this directory: `just api::test` from anywhere in the repository.

set shell := ["bash", "-euo", "pipefail", "-c"]

py_src := "src/ tests/"
# Runs a lint or test gate through gate-cache when it is installed
gate := "../scripts/gate-cache.sh"
compose := "docker compose -f ../compose.yml"

# The database the end-to-end suite owns, beside the development database in the
# server compose.yml starts. The e2e recipes name only this one, so the data a
# person built by hand in `crosstune` is out of their reach.
e2e_db := "crosstune_e2e"
e2e_database_url := "postgresql+asyncpg://crosstune:crosstune@localhost:5432/" + e2e_db

# Every process bound to the e2e database needs the e2e bucket too; the settings guard
# refuses the pair from api/.env, whose bucket belongs to the development database.
e2e_env := "CROSSTUNE_DATABASE_URL='" + e2e_database_url + "' CROSSTUNE_STORAGE_BUCKET=crosstune-e2e"

# Not the :8000 `just dev` serves, so the suite runs without stopping a dev session. The root
# justfile starts this port and web/justfile points the preview proxy at it.
e2e_port := trim(read("e2e-port"))

[private]
default:
    @just --list api

# Lint with ruff
[group('lint')]
ruff:
    {{ gate }} api-ruff uv run ruff check --no-fix --config pyproject.toml {{ py_src }}

# Check formatting with ruff
[group('lint')]
format:
    {{ gate }} api-ruff-format uv run ruff format --check --config pyproject.toml {{ py_src }}

# Type check with ty
[group('lint')]
ty:
    {{ gate }} api-ty uv run ty check

# Spell check with typos
[group('lint')]
typos:
    {{ gate }} api-typos uv run typos --config ../.typos.toml

# Run all linters
[group('lint')]
lint: ruff format ty typos contract-check

# Run the test suite on its own databases in the compose Postgres; args narrow the run and drop coverage
[group('test')]
[positional-arguments]
test *args:
    {{ gate }} api-test --argc "$#" --tool 'ffmpeg -version' just _test "$@"

[positional-arguments]
_test *args:
    docker info > /dev/null 2>&1 || { echo "Docker is not running" >&2; exit 1; }
    {{ compose }} up -d --wait postgres
    if [ "$#" -eq 0 ]; then set -- tests/ --cov --cov-config=pyproject.toml --cov-report=xml --cov-report=term; fi; uv run pytest -c pyproject.toml --color=yes "$@"

# Run the API with reload
[group('run')]
run:
    uv run uvicorn crosstune.main:app --reload --reload-dir src --port 8000

# Run the API against the end-to-end database, for `just web::e2e`
[group('run')]
run-e2e: e2e-db storage-setup _serve-e2e

# Serve the end-to-end database as it stands; `just e2e` prepares it first
_serve-e2e:
    @echo "serving {{ e2e_db }} on :{{ e2e_port }}"
    {{ e2e_env }} uv run uvicorn crosstune.main:app --port {{ e2e_port }}

# Wait for the e2e API started as process `pid` to answer, or print `log` and fail once it exits or 90 seconds pass
[group('run')]
wait-e2e pid log:
    #!/usr/bin/env bash
    set -euo pipefail
    health="http://localhost:{{ e2e_port }}/healthz"
    for _ in $(seq 1 90); do
        curl -fsS "$health" > /dev/null 2>&1 && exit 0
        kill -0 '{{ pid }}' 2> /dev/null || break
        sleep 1
    done
    curl -fsS "$health" > /dev/null 2>&1 && exit 0
    cat '{{ log }}'
    echo "the e2e API did not start" >&2
    exit 1

# Create the local RustFS buckets and their CORS rules; safe to repeat
[group('storage')]
storage-setup:
    uv run python -m crosstune.ops.local_storage setup

# Inspect local recordings: `ls [prefix]` or `get <key> [dest]`, with --bucket crosstune-e2e for the e2e bucket
[group('storage')]
[positional-arguments]
storage *args:
    uv run python -m crosstune.ops.local_storage --cwd '{{ invocation_directory() }}' "$@"

# Delete every object in a local bucket, the one api/.env names by default
[group('storage')]
[positional-arguments]
storage-reset *bucket:
    uv run python -m crosstune.ops.local_storage reset "$@"

# Apply pending migrations
[group('db')]
migrate:
    uv run alembic upgrade head

# Generate a migration from model changes; review it before committing
[group('db')]
makemigrations $message='auto':
    uv run alembic revision --autogenerate -m "$message"

# Create the end-to-end database if it is absent and migrate it to head
[group('db')]
e2e-db: (_e2e-db "keep")

# Drop the end-to-end database, recreate it empty, and migrate it to head
[group('db')]
e2e-db-reset: (_e2e-db "recreate")

# Give this worktree its own migrated copy of main's database and bucket; `reset` recopies both
[group('db')]
worktree-db mode='keep':
    #!/usr/bin/env bash
    set -euo pipefail
    case '{{ mode }}' in
        keep) flags=() ;;
        reset) flags=(--reset) ;;
        *) echo "mode is keep or reset, not '{{ mode }}'" >&2; exit 1 ;;
    esac
    {{ compose }} up -d --wait postgres rustfs
    # bash 3.2 treats an empty array as unbound under set -u.
    uv run python -m crosstune.ops.local_worktree provision ${flags[@]+"${flags[@]}"}
    if ! uv run alembic upgrade head; then
        echo "If alembic cannot locate a revision, main's database ran another branch's migration" >&2
        echo "and this copy inherited it. Downgrade main's database from that branch, then run" >&2
        echo "'just api::worktree-db reset'." >&2
        exit 1
    fi

# Drop the database and bucket of every worktree that no longer exists
[group('db')]
prune-worktree-dbs:
    {{ compose }} up -d --wait postgres rustfs
    uv run python -m crosstune.ops.local_worktree prune

_e2e-db mode:
    #!/usr/bin/env bash
    set -euo pipefail
    # "drop" has no public recipe: only `just e2e` creates a database it must remove.
    uv run python -m crosstune.ops.local_e2e_db '{{ mode }}' '{{ e2e_database_url }}'
    if [ '{{ mode }}' != "drop" ]; then
        {{ e2e_env }} uv run alembic upgrade head
        echo "{{ e2e_db }} is at head. The development database crosstune is untouched."
    fi

# Comp an account (Clerk ID or email), or revoke its comp
[group('billing')]
[positional-arguments]
comp *args:
    uv run python -m crosstune.ops.billing comp "$@"

# Refund and cancel an account's web subscription it withdrew from by email
[group('billing')]
[positional-arguments]
withdraw *args:
    uv run python -m crosstune.ops.billing withdraw "$@"

# Count accounts by country (countries)
[group('billing')]
[positional-arguments]
stats *args:
    uv run python -m crosstune.ops.stats "$@"

# Email every account about a change to the terms or privacy policy (--subject, --key, --body)
[group('accounts')]
[positional-arguments]
notify-accounts *args:
    uv run python -m crosstune.ops.notify_accounts "$@"

# Move the end of an account's trial
[group('billing')]
[positional-arguments]
trial *args:
    uv run python -m crosstune.ops.billing trial "$@"

# Preview, test-send, or run the inactive-account warnings (preview, send-test, run)
[group('billing')]
[positional-arguments]
inactivity *args:
    uv run python -m crosstune.ops.inactivity "$@"

# Preview, test-send, or run the inactive-account warnings on Railway development
[group('billing')]
[positional-arguments]
inactivity-railway *args:
    railway ssh --environment development --service crosstune -- python -m crosstune.ops.inactivity "$@"

# End or move the trial of an account in the e2e database, for the e2e suite
[group('billing')]
[positional-arguments]
e2e-trial *args:
    {{ e2e_env }} uv run python -m crosstune.ops.billing trial "$@" --e2e

# Seed, clear, or set the billing state of a Clerk development account
[group('testdata')]
[positional-arguments]
testdata *args:
    {{ compose }} up -d --wait postgres rustfs
    uv run python -m crosstune.ops.testdata "$@"

# Seed, clear, or set the billing state of a Railway development account
[group('testdata')]
[positional-arguments]
testdata-railway *args:
    railway ssh --environment development --service crosstune -- python -m crosstune.ops.testdata "$@"

# Export the OpenAPI schema every client generates its types from
[group('contract')]
contract:
    #!/usr/bin/env bash
    set -euo pipefail
    out=openapi.json
    # Written aside and moved into place, so a failed export leaves the committed
    # contract intact instead of truncating it.
    staged="$out.tmp"
    trap 'rm -f "$staged"' EXIT
    just _export-openapi "$staged"
    mv "$staged" "$out"

# Fail when the committed OpenAPI schema no longer matches the code
[group('lint')]
contract-check:
    {{ gate }} api-contract-check just _contract-check

_contract-check:
    #!/usr/bin/env bash
    set -euo pipefail
    case "${CI:-}" in 1|true|yes) echo "skipping contract check: CI runs it as its own job"; exit 0 ;; esac
    fresh="$(mktemp)"
    trap 'rm -f "$fresh"' EXIT
    just _export-openapi "$fresh"
    diff -u openapi.json "$fresh" || { echo "api/openapi.json is stale; run just contract" >&2; exit 1; }

_export-openapi out:
    @uv run python -c "import json; from crosstune.main import create_app; print(json.dumps(create_app().openapi(), indent=2, sort_keys=True))" > "{{ out }}"

# Upgrade dependencies
[group('maintenance')]
update:
    uv lock --upgrade
    uv sync

# Remove build artifacts and caches
[group('maintenance')]
clean:
    rm -rf .cache .coverage .coverage.* build dist *.egg-info
    find src tests -type d -name __pycache__ -prune -exec rm -rf {} +

# Install dependencies and create .env from the example if absent
[group('maintenance')]
setup:
    uv sync
    test -e .env || cp .env.example .env
    {{ compose }} up -d --wait rustfs
    just storage-setup
