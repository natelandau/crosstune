# Recipes for the API. Loaded as the `api` module by the root justfile and run
# from this directory: `just api::test` from anywhere in the repository.

import '../scripts/settings.just'

py_src := "src/ tests/"
# Runs a lint or test gate through gate-cache when it is installed
gate := "../scripts/gate-cache.sh"
compose := "docker compose -f ../compose.yml"
# Puts the API image's ffmpeg and ffprobe first on PATH, the build production runs
media_path := 'PATH="$(../scripts/media-tools.sh):$PATH"'

# The database the end-to-end suite owns, beside the development database in the
# server compose.yml starts. The e2e recipes name only this one, so the data a
# person built by hand in `crosstune` is out of their reach.
e2e_db := "crosstune_e2e"
e2e_database_url := "postgresql+asyncpg://crosstune:crosstune@localhost:5432/" + e2e_db

# Every process bound to the e2e database needs the e2e bucket too; the settings guard
# refuses the pair from api/.env, whose bucket belongs to the development database.
e2e_env := "CROSSTUNE_DATABASE_URL='" + e2e_database_url + "' CROSSTUNE_STORAGE_BUCKET=crosstune-e2e"

# Not the :8000 `just dev` serves, so the suite runs without stopping a dev session. The root
# justfile starts this port and web/justfile points the preview proxy at it.
e2e_port := trim(read("e2e-port"))

[default]
_default:
    @just --list api

# Lint with ruff
[group('lint')]
ruff:
    {{ gate }} api-ruff uv run --project .. ruff check --no-fix {{ py_src }}

# Check formatting with ruff
[group('lint')]
format:
    {{ gate }} api-ruff-format uv run --project .. ruff format --check {{ py_src }}

# Type check with ty
[group('lint')]
ty:
    {{ gate }} api-ty uv run --project .. ty check src

# Spell check with typos
[group('lint')]
typos:
    {{ gate }} api-typos uv run --project .. --only-group typos typos --config ../.typos.toml

# Run all linters
[group('lint')]
lint: ruff format ty typos contract-check

# Run the tests; any args drop coverage
[group('test')]
[arg("args", help="Arguments for pytest; any narrows the run and drops coverage")]
test *args:
    {{ media_path }} {{ gate }} api-test --argc "$#" --tool 'ffmpeg -version' just _test "$@"

_test *args:
    docker info > /dev/null 2>&1 || { echo "Docker is not running" >&2; exit 1; }
    {{ compose }} up -d --wait postgres-test
    if [ "$#" -eq 0 ]; then set -- tests/ --cov --cov-config=pyproject.toml --cov-report=xml --cov-report=term; fi; uv run pytest -c pyproject.toml --color=yes "$@"

# Run the API with reload
[group('run')]
run:
    {{ media_path }} uv run uvicorn crosstune.main:app --reload --reload-dir src --port 8000

# Run the API on the e2e database
[group('run')]
run-e2e: e2e-db storage-setup _serve-e2e

# Serve the end-to-end database unchanged; `just e2e` prepares it first
_serve-e2e:
    @echo "serving {{ e2e_db }} on :{{ e2e_port }}"
    {{ media_path }} {{ e2e_env }} uv run uvicorn crosstune.main:app --port {{ e2e_port }}

# Wait for the e2e API to answer
[group('run')]
[arg("pid", help="The process ID of the e2e API")]
[arg("log", help="The file the e2e API logs to")]
[script]
wait-e2e pid log:
    health="http://localhost:{{ e2e_port }}/healthz"
    for _ in $(seq 1 90); do
        curl -fsS "$health" > /dev/null 2>&1 && exit 0
        kill -0 '{{ pid }}' 2> /dev/null || break
        sleep 1
    done
    curl -fsS "$health" > /dev/null 2>&1 && exit 0
    cat '{{ log }}'
    echo "the e2e API did not start" >&2
    exit 1

# Create the local buckets; safe to repeat
[group('storage')]
storage-setup:
    uv run python -m crosstune.ops.local_storage setup

# List or download local recordings
[group('storage')]
[arg("args", help="`ls [prefix]` or `get <key> [dest]`, and --bucket")]
storage *args:
    uv run python -m crosstune.ops.local_storage --cwd '{{ invocation_directory() }}' "$@"

# Empty a local bucket
[group('storage')]
[arg("bucket", help="The bucket to empty; defaults to the one api/.env names")]
storage-reset *bucket:
    uv run python -m crosstune.ops.local_storage reset "$@"

# Apply pending migrations
[group('db')]
migrate:
    uv run alembic upgrade head

# Generate a migration from model changes
[group('db')]
[arg("message", help="The migration's message")]
makemigrations $message='auto':
    uv run alembic revision --autogenerate -m "$message"

# Create and migrate the e2e database
[group('db')]
e2e-db: (_e2e-db "keep")

# Recreate the e2e database empty
[group('db')]
e2e-db-reset: (_e2e-db "recreate")

# Copy main's database for this worktree
[group('db')]
worktree-db: (_worktree-db "")

# Recopy main's database for this worktree
[group('db')]
worktree-db-reset: (_worktree-db "--reset")

[script]
_worktree-db flag:
    {{ compose }} up -d --wait postgres rustfs
    uv run python -m crosstune.ops.local_worktree provision {{ flag }}
    if ! uv run alembic upgrade head; then
        echo "If alembic cannot locate a revision, main's database ran another branch's migration" >&2
        echo "and this copy inherited it. Downgrade main's database from that branch, then run" >&2
        echo "'just api::worktree-db-reset'." >&2
        exit 1
    fi

# Drop databases of removed worktrees
[group('db')]
prune-worktree-dbs:
    {{ compose }} up -d --wait postgres rustfs
    uv run python -m crosstune.ops.local_worktree prune

[arg("mode", pattern="keep|recreate|drop")]
[script]
_e2e-db mode:
    # "drop" has no public recipe: only `just e2e` creates a database it must remove.
    uv run python -m crosstune.ops.local_e2e_db '{{ mode }}' '{{ e2e_database_url }}'
    if [ '{{ mode }}' != "drop" ]; then
        {{ e2e_env }} uv run alembic upgrade head
        echo "{{ e2e_db }} is at head. The development database crosstune is untouched."
    fi

# Move an account's trial in the e2e database
[group('testdata')]
[arg("args", help="A Clerk user ID and the trial options of `ops::billing trial`")]
e2e-trial *args:
    {{ e2e_env }} uv run python -m crosstune.ops.billing trial "$@" --e2e

# Seed or set the state of a dev account
[group('testdata')]
[arg("args", help="An email or Clerk user ID, then options; --help lists them")]
testdata *args:
    {{ compose }} up -d --wait postgres rustfs
    uv run python -m crosstune.ops.testdata "$@"

# Seed or set a Railway dev account
[group('testdata')]
[arg("args", help="An email or Clerk user ID, then options; --help lists them")]
testdata-railway *args:
    railway ssh --environment development --service crosstune -- python -m crosstune.ops.testdata "$@"

# Export the OpenAPI schema to openapi.json
[group('contract')]
[script]
contract:
    out=openapi.json
    # Written aside and moved into place, so a failed export leaves the committed
    # contract intact instead of truncating it.
    staged="$out.tmp"
    trap 'rm -f "$staged"' EXIT
    just _export-openapi "$staged"
    mv "$staged" "$out"

# Fail when openapi.json is stale
[group('lint')]
contract-check:
    {{ gate }} api-contract-check just _contract-check

[script]
_contract-check:
    case "${CI:-}" in 1|true|yes) echo "skipping contract check: CI runs it as its own job"; exit 0 ;; esac
    fresh="$(mktemp)"
    trap 'rm -f "$fresh"' EXIT
    just _export-openapi "$fresh"
    diff -u openapi.json "$fresh" || { echo "api/openapi.json is stale; run just contract" >&2; exit 1; }

_export-openapi out:
    @uv run python -m crosstune.ops.openapi '{{ out }}'

# Upgrade dependencies
[group('maintenance')]
update:
    uv lock --upgrade
    uv sync

# Remove build artifacts and caches
[group('maintenance')]
clean:
    rm -rf .cache .coverage .coverage.* build dist *.egg-info
    find src tests -type d -name __pycache__ -prune -exec rm -rf {} +
    # One media container per image the media stage has built; the next run starts its own
    docker ps --all --quiet --filter name=crosstune-media- | xargs docker container rm --force > /dev/null 2>&1 || true

# Install dependencies and create .env
[group('maintenance')]
setup:
    uv sync
    test -e .env || cp .env.example .env
    {{ compose }} up -d --wait rustfs
    just storage-setup
