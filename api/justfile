# Recipes for the API. Loaded as the `api` module by the root justfile and run
# from this directory: `just api::test` from anywhere in the repository.

set shell := ["bash", "-euo", "pipefail", "-c"]

py_src := "src/ tests/"

# The database the end-to-end suite owns, beside the development database in the
# server compose.yml starts. The e2e recipes name only this one, so the data a
# person built by hand in `crosstune` is out of their reach.
e2e_db := "crosstune_e2e"
e2e_database_url := "postgresql+asyncpg://crosstune:crosstune@localhost:5432/" + e2e_db

# Not the :8000 `just dev` serves, so the suite runs without stopping a dev session. The root
# justfile starts this port and web/justfile points the preview proxy at it.
e2e_port := "8001"

[private]
default:
    @just --list api

# Lint with ruff
[group('lint')]
ruff:
    uv run ruff check --no-fix --config pyproject.toml {{ py_src }}

# Check formatting with ruff
[group('lint')]
format:
    uv run ruff format --check --config pyproject.toml {{ py_src }}

# Type check with ty
[group('lint')]
ty:
    uv run ty check

# Spell check with typos
[group('lint')]
typos:
    uv run typos --config ../.typos.toml

# Run every prek hook against all files (prek runs its own job in CI)
[group('lint')]
precommit:
    #!/usr/bin/env bash
    set -euo pipefail
    case "${CI:-}" in 1|true|yes) echo "skipping prek hooks: CI runs them as their own job"; exit 0 ;; esac
    cd .. && PREK_SKIP=pytest uv run --project api prek run --all-files --config .pre-commit-config.yaml

# Run all linters
[group('lint')]
lint: ruff format ty typos precommit

# Run the test suite against a Postgres container; args narrow the run and drop coverage
[group('test')]
test *args:
    docker info > /dev/null 2>&1 || { echo "Docker is not running" >&2; exit 1; }
    uv run pytest -c pyproject.toml --color=yes {{ if args == "" { "tests/ --cov --cov-config=pyproject.toml --cov-report=xml --cov-report=term" } else { args } }}

# Run the API with reload
[group('run')]
run:
    uv run uvicorn crosstune.main:app --reload --reload-dir src --port 8000

# Run the API against the end-to-end database, for `just web::e2e`
[group('run')]
run-e2e: e2e-db
    just storage-setup
    @echo "serving {{ e2e_db }} on :{{ e2e_port }}"
    CROSSTUNE_DATABASE_URL='{{ e2e_database_url }}' CROSSTUNE_R2_BUCKET=crosstune-e2e uv run uvicorn crosstune.main:app --port {{ e2e_port }}

# Create the local RustFS buckets and their CORS rules; safe to repeat
[group('storage')]
storage-setup:
    uv run python -m crosstune.ops.local_storage setup

# Inspect local recordings: `ls [prefix]` or `get <key> [dest]`, with --bucket crosstune-e2e for the e2e bucket
[group('storage')]
storage *args:
    uv run python -m crosstune.ops.local_storage {{ args }}

# Delete every object in a local bucket, crosstune-local by default
[group('storage')]
storage-reset bucket='crosstune-local':
    uv run python -m crosstune.ops.local_storage reset {{ bucket }}

# Apply pending migrations
[group('db')]
migrate:
    uv run alembic upgrade head

# Generate a migration from model changes; review it before committing
[group('db')]
makemigrations message='auto':
    uv run alembic revision --autogenerate -m '{{ message }}'

# Create the end-to-end database if it is absent and migrate it to head
[group('db')]
e2e-db: (_e2e-db "keep")

# Drop the end-to-end database, recreate it empty, and migrate it to head
[group('db')]
e2e-db-reset: (_e2e-db "recreate")

# _e2e-db also takes "drop", which leaves no database behind. It has no recipe of its own,
# because `just e2e` drops what it created and nothing else has a database to drop.


[private]
_e2e-db mode:
    #!/usr/bin/env bash
    set -euo pipefail
    uv run python - '{{ e2e_database_url }}' '{{ mode }}' <<'PY'
    import asyncio
    import sys
    from urllib.parse import urlsplit, urlunsplit

    import asyncpg

    url, mode = sys.argv[1], sys.argv[2]
    parts = urlsplit(url)
    name = parts.path.lstrip("/")
    # The one guard between a reset and a developer's own data.
    if not name.endswith("_e2e"):
        sys.exit(f"refusing to act on {name}: these recipes own a _e2e database and nothing else")
    admin_url = urlunsplit(("postgresql", parts.netloc, "/postgres", "", ""))
    # A quoted identifier ends at its first quote, so every quote in the name is doubled.
    identifier = name.replace('"', '""')


    async def prepare() -> None:
        try:
            conn = await asyncpg.connect(admin_url)
        except OSError as exc:
            server = parts.netloc.rsplit("@", 1)[-1]
            sys.exit(f"no Postgres at {server}: {exc}. Start it with `docker compose up -d`")
        try:
            if mode in {"recreate", "drop"}:
                # Postgres refuses to drop a database that still has sessions on it, and a
                # drop follows a run whose API may still hold its pool open.
                existed = await conn.fetchval("select 1 from pg_database where datname = $1", name)
                await conn.execute(f'drop database if exists "{identifier}" with (force)')
                print(f"dropped {name}" if existed else f"{name} was not there")
            if mode == "drop":
                return
            if await conn.fetchval("select 1 from pg_database where datname = $1", name):
                print(f"{name} is already there")
            else:
                await conn.execute(f'create database "{identifier}"')
                print(f"created {name}")
        finally:
            await conn.close()


    asyncio.run(prepare())
    PY
    if [ '{{ mode }}' != "drop" ]; then
        CROSSTUNE_DATABASE_URL='{{ e2e_database_url }}' uv run alembic upgrade head
        echo "{{ e2e_db }} is at head. The development database crosstune is untouched."
    fi

# Export the OpenAPI schema for the web client
[group('contract')]
contract:
    #!/usr/bin/env bash
    set -euo pipefail
    out=../web/src/api/openapi.json
    mkdir -p "$(dirname "$out")"
    # Written aside and moved into place, so a failed export leaves the committed
    # contract intact instead of truncating it.
    staged="$out.tmp"
    trap 'rm -f "$staged"' EXIT
    uv run python -c "import json; from crosstune.main import create_app; print(json.dumps(create_app().openapi(), indent=2, sort_keys=True))" > "$staged"
    mv "$staged" "$out"

# Upgrade dependencies
[group('maintenance')]
update:
    uv lock --upgrade
    uv sync

# Remove build artifacts and caches
[group('maintenance')]
clean:
    rm -rf .cache .coverage .coverage.* build dist *.egg-info
    find src tests -type d -name __pycache__ -prune -exec rm -rf {} +

# Install dependencies and create .env from the example if absent
[group('maintenance')]
setup:
    uv sync
    test -e .env || cp .env.example .env
    docker compose -f ../compose.yml up -d --wait rustfs
    just storage-setup
