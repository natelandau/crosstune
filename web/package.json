{
  "name": "crosstune-web",
  "private": true,
  "version": "0.16.0",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:hosted": "bash scripts/hosted-build.sh",
    "deploy:preview": "slug=\"$(node scripts/branch-slug.mjs)\" && wrangler versions upload --preview-alias \"$slug\"",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --check .",
    "fix": "eslint --fix . && prettier --write .",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "contract": "openapi-typescript ../api/openapi.json -o src/api/schema.d.ts"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.41",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "fflate": "^0.8.3",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "minimatch": "^10.2.6",
    "openapi-typescript": "^7.13.0",
    "playwright": "1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.145.0"
  },
  "dependencies": {
    "@clerk/react": "^6.17.4",
    "@ionic/react": "^9.0.6",
    "@ionic/react-router": "^9.0.6",
    "@sentry/react": "^11.1.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.49.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^6.30.6",
    "react-router-dom": "^6.30.6",
    "signalsmith-stretch": "^1.3.2",
    "uuid": "^14.0.2"
  }
}
