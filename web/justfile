# Recipes for the web client. Loaded as the `web` module by the root justfile and run
# from this directory: `just web::test` from anywhere in the repository.

import '../scripts/settings.just'

# Where `just api::run-e2e` serves. Not the :8000 of a dev session, so the suite and
# `just dev` run side by side.
e2e_api := "http://localhost:" + trim(read("../api/e2e-port"))

# Runs a lint or test gate through gate-cache when it is installed
gate := "../scripts/gate-cache.sh"

[default]
_default:
    @just --list web

# Lint with eslint
[group('lint')]
eslint:
    {{ gate }} web-eslint pnpm eslint --max-warnings 0 .

# Check formatting with prettier
[group('lint')]
format:
    {{ gate }} web-prettier pnpm prettier --check .

# Type check with tsc
[group('lint')]
tsc:
    {{ gate }} web-tsc pnpm tsc --noEmit

# Spell check the client and its brand sources
[group('lint')]
typos:
    {{ gate }} web-typos uv run --project ../api --only-group typos typos --config ../.typos.toml . ../brand

# Find unused files, exports, and dependencies with knip
[group('lint')]
deadcode:
    {{ gate }} web-knip pnpm knip --no-progress

# Fail when the typed client is stale
[group('lint')]
contract-check:
    {{ gate }} web-contract-check just _contract-check

[script]
_contract-check:
    case "${CI:-}" in 1|true|yes) echo "skipping contract check: CI runs it as its own job"; exit 0 ;; esac
    out=.cache/contract-check
    rm -rf "$out" && mkdir -p "$out"
    trap 'rm -rf "$out"' EXIT
    just _generate "$out"
    stale=0
    for f in schema.d.ts vocabulary.ts; do
        diff -u "src/api/$f" "$out/$f" || stale=1
    done
    [ "$stale" -eq 0 ] || { echo "web/src/api is stale; run just contract" >&2; exit 1; }

# Fail when CI's Playwright image drifts
[group('lint')]
playwright-image:
    {{ gate }} web-playwright-image just _playwright-image

[script]
_playwright-image:
    pinned=$(node -p "require('./package.json').devDependencies.playwright")
    image=$(sed -nE 's|^ *image: mcr\.microsoft\.com/playwright:v([^-]+)-.*|\1|p' ../.github/workflows/web.yml)
    [ "$image" = "$pinned" ] || {
        echo "web.yml runs the tests on Playwright image '${image:-none}', but package.json pins $pinned" >&2
        exit 1
    }

# Run all linters
[group('lint')]
lint: eslint format tsc typos deadcode contract-check playwright-image

# Fix lint and formatting where tools can
[group('lint')]
fix:
    pnpm eslint --fix .
    pnpm prettier --write .

# Run the unit and browser tests with coverage
[group('test')]
[arg("args", help="Arguments for vitest; any drops coverage")]
test *args:
    {{ gate }} web-test --argc "$#" --file .env --tool 'node --version' just _test "$@"

# V8 coverage reads Chromium's profiler, which WebKit lacks, so WebKit runs on its own.
_test *args:
    if [ "$#" -gt 0 ]; then exec pnpm vitest run "$@"; fi; pnpm vitest run --coverage --project unit --project browser && pnpm vitest run --project browser-webkit

# Run only the jsdom unit project
[group('test')]
[arg("args", help="Arguments for vitest")]
test-unit *args:
    {{ gate }} web-test-unit --argc "$#" --file .env --tool 'node --version' pnpm vitest run --project unit "$@"

# Run only the browser projects: Chromium and WebKit
[group('test')]
[arg("args", help="Arguments for vitest")]
test-browser *args:
    {{ gate }} web-test-browser --argc "$#" --file .env --tool 'node --version' pnpm vitest run --project browser --project browser-webkit "$@"

# Rerun tests shuffled to find a flaky one
[group('test')]
[arg("runs", pattern="[0-9]+", help="How many shuffled runs; SEED=<n> in the environment replays one")]
[arg("args", help="Test files or vitest arguments; none takes the branch's changed test files")]
stress runs *args:
    scripts/stress.sh "$@"

# Run Playwright against a production build
[group('test')]
[arg("args", help="Arguments for Playwright")]
[script]
e2e *args:
    fix="run 'just e2e' from the repository root, which starts one"
    # Only a database the e2e suite owns names itself in the health response, so an API
    # bound to anyone's development database is turned away before a fixture is written.
    health=$(curl -fsS {{ e2e_api }}/healthz) || { echo "no API answers on {{ e2e_api }}: $fix" >&2; exit 1; }
    node -e 'process.exit(JSON.parse(process.argv[1]).database ? 0 : 1)' "$health" \
        || { echo "the API on {{ e2e_api }} is not bound to the e2e database: $fix" >&2; exit 1; }
    # The preview server Playwright starts proxies /v1, so this is what sends the suite's
    # writes to the e2e database rather than to whatever :8000 is serving.
    LOCAL_API_PROXY_TARGET='{{ e2e_api }}' pnpm playwright test "$@"

# Run the dev server with the /v1 proxy
[group('run')]
run:
    pnpm vite

# Serve the production build with the /v1 proxy
[group('run')]
preview:
    pnpm vite build
    pnpm vite preview

# Capture the component gallery and screens
[group('run')]
gallery-shots:
    node scripts/gallery-shots.ts

# Build for production and validate the Worker
[group('build')]
build:
    pnpm vite build
    pnpm wrangler deploy --dry-run

# Regenerate the favicon and PWA icons
[group('build')]
icons:
    cp ../brand/icon-dark.svg public/logo.svg
    pnpm pwa-assets-generator

# Regenerate the typed client from the contract
[group('contract')]
[script]
contract:
    out=.cache/contract
    rm -rf "$out" && mkdir -p "$out"
    trap 'rm -rf "$out"' EXIT
    just _generate "$out"
    mv "$out/schema.d.ts" "$out/vocabulary.ts" src/api/

# Write the typed client and the vocabulary into `out`; `contract` and `contract-check` share
# it, so the check compares exactly what `contract` would commit
[script]
_generate $out:
    pnpm --silent openapi-typescript ../api/openapi.json -o "$out/schema.d.ts" > /dev/null
    node scripts/vocabulary.ts ../api/openapi.json "$out/vocabulary.raw.ts"
    # Formatted as the committed file's path so prettier applies that file's config.
    pnpm --silent exec prettier --stdin-filepath src/api/vocabulary.ts < "$out/vocabulary.raw.ts" > "$out/vocabulary.ts"
    rm "$out/vocabulary.raw.ts"

# Upgrade dependencies within dependabot's ranges
[group('maintenance')]
update:
    pnpm update --latest '!typescript' '!@types/node'
    pnpm update typescript @types/node

# Remove build artifacts and caches
[group('maintenance')]
clean:
    rm -rf dist dev-dist coverage playwright-report test-results node_modules/.vite .vitest

# Install dependencies and browsers; create .env
[group('maintenance')]
setup:
    pnpm install --frozen-lockfile
    pnpm exec playwright install chromium webkit
    test -e .env || cp .env.example .env
