# Recipes for the web client. Loaded as the `web` module by the root justfile and run
# from this directory: `just web::test` from anywhere in the repository.

set shell := ["bash", "-euo", "pipefail", "-c"]

# Where `just api::run-e2e` serves. Not the :8000 of a dev session, so the suite and
# `just dev` run side by side.
e2e_api := "http://localhost:8001"

[private]
default:
    @just --list web

# Lint with eslint
[group('lint')]
eslint:
    pnpm eslint --max-warnings 0 .

# Check formatting with prettier
[group('lint')]
format:
    pnpm prettier --check .

# Type check with tsc
[group('lint')]
tsc:
    pnpm tsc --noEmit

# Spell check the client and the brand sources it is built from
[group('lint')]
typos:
    uv run --project ../api --only-group typos typos --config ../.typos.toml . ../brand

# Fail when the committed client types no longer match the committed OpenAPI schema
[group('lint')]
contract-check:
    #!/usr/bin/env bash
    set -euo pipefail
    case "${CI:-}" in 1|true|yes) echo "skipping contract check: CI runs it as its own job"; exit 0 ;; esac
    out=.cache/contract-check
    rm -rf "$out" && mkdir -p "$out"
    trap 'rm -rf "$out"' EXIT
    pnpm --silent openapi-typescript ../api/openapi.json -o "$out/schema.d.ts" > /dev/null
    node scripts/vocabulary.mjs ../api/openapi.json "$out/vocabulary.raw.ts"
    # Formatted as the committed file's path so prettier applies that file's config.
    pnpm --silent exec prettier --stdin-filepath src/api/vocabulary.ts < "$out/vocabulary.raw.ts" > "$out/vocabulary.ts"
    stale=0
    for f in schema.d.ts vocabulary.ts; do
        diff -u "src/api/$f" "$out/$f" || stale=1
    done
    [ "$stale" -eq 0 ] || { echo "web/src/api is stale; run just contract" >&2; exit 1; }

# Run all linters
[group('lint')]
lint: eslint format tsc typos contract-check

# Fix lint and formatting where tools can
[group('lint')]
fix:
    pnpm eslint --fix .
    pnpm prettier --write .

# Run the unit and browser tests; extra args go to vitest
[group('test')]
[positional-arguments]
test *args:
    pnpm vitest run "$@"

# Run only the jsdom unit project
[group('test')]
[positional-arguments]
test-unit *args:
    pnpm vitest run --project unit "$@"

# Run only the Chromium browser projects, in the detected mode and forced iOS
[group('test')]
[positional-arguments]
test-browser *args:
    pnpm vitest run --project browser --project browser-ios "$@"

# Run tests shuffled, a new order each run, and list the seeds that failed; SEED=<n> replays one
[group('test')]
[positional-arguments]
stress runs *args:
    #!/usr/bin/env bash
    set -uo pipefail
    shift
    # Shuffling exposes a test that leans on state an earlier test left behind, which file
    # order hides.
    if [[ -n "${SEED:-}" ]]; then
        exec pnpm vitest run --sequence.shuffle --sequence.seed="$SEED" "$@"
    fi
    failed=()
    for run in $(seq 1 {{ runs }}); do
        seed=$RANDOM$RANDOM
        echo "run $run/{{ runs }}, seed $seed"
        pnpm vitest run --sequence.shuffle --sequence.seed="$seed" "$@" || failed+=("$seed")
    done
    if (( ${#failed[@]} )); then
        echo "${#failed[@]} of {{ runs }} runs failed; replay one with SEED=<seed> just web::stress 1 {{ args }}"
        printf '  %s\n' "${failed[@]}"
        exit 1
    fi
    echo "all {{ runs }} runs passed"

# Run the Playwright suite against a production build; needs the e2e API and Clerk env
[group('test')]
[positional-arguments]
e2e *args:
    #!/usr/bin/env bash
    set -euo pipefail
    fix="run 'just e2e' from the repository root, which starts one"
    # Only a database the e2e suite owns names itself in the health response, so an API
    # bound to anyone's development database is turned away before a fixture is written.
    health=$(curl -fsS {{ e2e_api }}/healthz) || { echo "no API answers on {{ e2e_api }}: $fix" >&2; exit 1; }
    node -e 'process.exit(JSON.parse(process.argv[1]).database ? 0 : 1)' "$health" \
        || { echo "the API on {{ e2e_api }} is not bound to the e2e database: $fix" >&2; exit 1; }
    # The preview server Playwright starts proxies /v1, so this is what sends the suite's
    # writes to the e2e database rather than to whatever :8000 is serving.
    LOCAL_API_PROXY_TARGET='{{ e2e_api }}' pnpm playwright test "$@"

# Run the dev server with the /v1 proxy
[group('run')]
run:
    pnpm vite

# Serve the production build with the /v1 proxy
[group('run')]
preview:
    pnpm vite build
    pnpm vite preview

# Build for production and validate the Worker config and bundle without uploading
[group('build')]
build:
    pnpm vite build
    pnpm wrangler deploy --dry-run

# Regenerate the favicon and PWA icons in public/ from the brand mark in ../brand
[group('build')]
icons:
    cp ../brand/icon-dark.svg public/logo.svg
    pnpm pwa-assets-generator

# Regenerate the typed client from the committed OpenAPI contract
[group('contract')]
contract:
    pnpm openapi-typescript ../api/openapi.json -o src/api/schema.d.ts
    node scripts/vocabulary.mjs ../api/openapi.json src/api/vocabulary.ts
    pnpm exec prettier --write src/api/vocabulary.ts > /dev/null

# Upgrade dependencies, holding the majors .github/dependabot.yml ignores to their range
[group('maintenance')]
update:
    pnpm update --latest '!react-router' '!react-router-dom' '!typescript' '!@types/node'
    pnpm update react-router react-router-dom typescript @types/node

# Remove build artifacts and caches
[group('maintenance')]
clean:
    rm -rf dist dev-dist coverage playwright-report test-results node_modules/.vite .vitest

# Install dependencies, browsers, and create .env from the example if absent
[group('maintenance')]
setup:
    pnpm install --frozen-lockfile
    pnpm exec playwright install chromium
    test -e .env || cp .env.example .env
