# Required. The Publishable Key (pk_test_...) of the Clerk development instance,
# from the API keys page in the Clerk Dashboard.
VITE_CLERK_PUBLISHABLE_KEY=

# Optional. The DSN of the crosstune-web project, from Project Settings > Client
# Keys (DSN) in Sentry. If this is unset, the app does not send errors to Sentry.
# VITE_SENTRY_DSN=

# Optional. The environment name that tags Sentry events. Hosted builds use
# production or development.
VITE_SENTRY_ENVIRONMENT=development

# Local development only. This name has no VITE_ prefix, so Vite never puts it
# in the bundle.

# Optional. A comma-separated list of extra hostnames the dev and preview
# servers answer to. A leading dot allows a domain and all its subdomains. Set
# it when a proxy such as Tailscale Serve forwards to the server, since Vite
# answers only to localhost and IP addresses by default.
# DEV_SERVER_ALLOWED_HOSTS=.ts.net

# End-to-end tests only. These names have no VITE_ prefix, so Vite never puts
# them in the bundle.

# Required for end-to-end tests. The Secret Key (sk_test_...) of the Clerk
# development instance, from the API keys page in the Clerk Dashboard.
CLERK_SECRET_KEY=

# Required for end-to-end tests. The email address of a user in the Clerk
# development instance, from the Users page in the Clerk Dashboard.
E2E_CLERK_USER_EMAIL=
