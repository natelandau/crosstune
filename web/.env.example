# Settings for the web client, its dev server, and the end-to-end suite.
# `just web::setup` copies this file to web/.env. Every name the web code reads
# is here, including the ones a host sets, which stay commented out in the last
# section. docs/hosting.md has the hosted values.
#
# Vite puts only VITE_ names in the bundle. Every other name here stays on the
# machine that runs the dev server, the build, or the suite.

# ==== Sign-in (Clerk) ========================================================

# Required. The Publishable Key (pk_test_...) of the Clerk development instance,
# from the API keys page in the Clerk Dashboard.
VITE_CLERK_PUBLISHABLE_KEY=

# ==== Error reporting ========================================================

# Optional. The DSN of the crosstune-web project, from Project Settings > Client
# Keys (DSN) in Sentry. If this is unset, the app does not send errors to Sentry.
# VITE_SENTRY_DSN=

# Optional. The environment name that tags Sentry events. Hosted builds use
# production or development.
VITE_SENTRY_ENVIRONMENT=development

# ==== API location ===========================================================

# Optional. Where the API is, for a build that is not served from the same
# origin as the API (a Capacitor app). Unset, the client calls /v1 on its own
# origin, which is what the Worker and the dev proxy serve.
# VITE_API_ORIGIN=https://api.crosstune.app

# ==== Local development only =================================================

# Optional. A comma-separated list of extra hostnames the dev and preview
# servers answer to. A leading dot allows a domain and all its subdomains. Set
# it when a proxy such as Tailscale Serve forwards to the server, since Vite
# answers only to localhost and IP addresses by default.
# LOCAL_ALLOWED_HOSTS=.ts.net

# Optional. Where the dev and preview servers proxy /v1. `just web::e2e` sets it
# to the end-to-end API on :8001 for one run; leave it unset otherwise.
# LOCAL_API_PROXY_TARGET=http://localhost:8000

# ==== End-to-end tests only ==================================================

# Required for end-to-end tests. The Secret Key (sk_test_...) of the Clerk
# development instance, from the API keys page in the Clerk Dashboard. The name
# is the one @clerk/testing reads.
CLERK_SECRET_KEY=

# Required for end-to-end tests. The email address of a user in the Clerk
# development instance, from the Users page in the Clerk Dashboard.
E2E_CLERK_USER_EMAIL=

# ==== Set by a host or CI only ===============================================

# Never set these locally. docs/hosting.md says where each one is set.

# Workers Builds build variables, read by scripts/hosted-build.sh. It exports
# the one that matches the branch as VITE_CLERK_PUBLISHABLE_KEY.
# CLERK_PUBLISHABLE_KEY_PRODUCTION=
# CLERK_PUBLISHABLE_KEY_DEVELOPMENT=

# Workers Builds injects the branch it builds. scripts/hosted-build.sh picks
# the Clerk instance from it, and scripts/branch-slug.mjs the preview alias.
# GitHub Actions sets GITHUB_HEAD_REF, which branch-slug.mjs reads in the
# Preview workflow.
# WORKERS_CI_BRANCH=
# GITHUB_HEAD_REF=

# GitHub Actions sets CI=true. Playwright then retries once and reports in the
# GitHub format.
# CI=

# The Worker's runtime variables live in wrangler.jsonc, not in an env file:
# WORKER_NAME, API_ORIGIN_PRODUCTION, and API_ORIGIN_DEVELOPMENT, which pick
# the API that /v1 reaches, and the PREVIEW_API_ORIGINS KV binding.
