# Recipes for the repository's tooling scripts: the Python here and in apple/scripts. Loaded
# as the `scripts` module by the root justfile and run from this directory.

set shell := ["bash", "-euo", "pipefail", "-c"]
set script-interpreter := ["bash", "-euo", "pipefail"]
set positional-arguments

# Runs a lint or test gate through gate-cache when it is installed
gate := "./gate-cache.sh"
python_src := ". ../apple/scripts"

[default]
_default:
    @just --list scripts

# Lint with ruff
[group('lint')]
ruff:
    {{ gate }} scripts-ruff uv run --project ../api ruff check --no-fix {{ python_src }}

# Check formatting with ruff
[group('lint')]
format:
    {{ gate }} scripts-ruff-format uv run --project ../api ruff format --check {{ python_src }}

# Type check with ty
[group('lint')]
ty:
    {{ gate }} scripts-ty uv run --project ../api ty check {{ python_src }}

# Run all linters
[group('lint')]
lint: ruff format ty

# Fix lint and formatting where ruff can
[group('lint')]
fix:
    uv run --project ../api ruff check --fix {{ python_src }}
    uv run --project ../api ruff format {{ python_src }}

# Run the scripts' tests
[group('test')]
[arg("args", help="Arguments for pytest; any narrows the run")]
test *args:
    {{ gate }} scripts-test --argc "$#" uv run --project ../api pytest -c pytest.ini "$@"
