# Recipes for the repository's tooling scripts. Lint covers every Python file outside api/,
# which the api module lints. Loaded as the `scripts` module by the root justfile and run from
# this directory.

import 'settings.just'

# Runs a lint or test gate through gate-cache when it is installed
gate := "./gate-cache.sh"
# Ruff and ty skip what .gitignore lists, so a new folder of scripts is linted without a change here.
# A bare `api` would also skip every nested folder named api; ty.toml excludes api/ for ty.
ruff_src := "--extend-exclude ../api .."

[default]
_default:
    @just --list scripts

# Lint with ruff
[group('lint')]
ruff:
    {{ gate }} scripts-ruff uv run --project .. ruff check --no-fix {{ ruff_src }}

# Check formatting with ruff
[group('lint')]
format:
    {{ gate }} scripts-ruff-format uv run --project .. ruff format --check {{ ruff_src }}

# Type check with ty
[group('lint')]
ty:
    {{ gate }} scripts-ty uv run --project .. ty check ..

# Run all linters
[group('lint')]
lint: ruff format ty

# Fix lint and formatting where ruff can
[group('lint')]
fix:
    uv run --project .. ruff check --fix {{ ruff_src }}
    uv run --project .. ruff format {{ ruff_src }}

# Run the scripts' tests
[group('test')]
[arg("args", help="Arguments for pytest; any narrows the run")]
test *args:
    {{ gate }} scripts-test --argc "$#" uv run --project .. pytest -c pytest.ini "$@"
