# Recipes for the repository's tooling scripts. Lint covers every Python file outside api/,
# which the api module lints. Loaded as the `scripts` module by the root justfile and run from
# this directory.

set shell := ["bash", "-euo", "pipefail", "-c"]
set script-interpreter := ["bash", "-euo", "pipefail"]
set positional-arguments

# Runs a lint or test gate through gate-cache when it is installed
gate := "./gate-cache.sh"
# Ruff and ty skip what .gitignore lists, so a new folder of scripts is linted without a change here.
ruff_src := "--extend-exclude api .."
ty_src := "--exclude api/ .."

[default]
_default:
    @just --list scripts

# Lint with ruff
[group('lint')]
ruff:
    {{ gate }} scripts-ruff uv run --project ../api ruff check --no-fix {{ ruff_src }}

# Check formatting with ruff
[group('lint')]
format:
    {{ gate }} scripts-ruff-format uv run --project ../api ruff format --check {{ ruff_src }}

# Type check with ty
[group('lint')]
ty:
    {{ gate }} scripts-ty uv run --project ../api ty check {{ ty_src }}

# Run all linters
[group('lint')]
lint: ruff format ty

# Fix lint and formatting where ruff can
[group('lint')]
fix:
    uv run --project ../api ruff check --fix {{ ruff_src }}
    uv run --project ../api ruff format {{ ruff_src }}

# Run the scripts' tests
[group('test')]
[arg("args", help="Arguments for pytest; any narrows the run")]
test *args:
    {{ gate }} scripts-test --argc "$#" uv run --project ../api pytest -c pytest.ini "$@"
